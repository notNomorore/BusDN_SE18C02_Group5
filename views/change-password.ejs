<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đổi mật khẩu | BusDN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container mt-5">
        <div class="card mx-auto shadow" style="max-width: 500px;">
            <div class="card-header bg-warning text-dark text-center">
                <h4>🔒 ĐỔI MẬT KHẨU</h4>
            </div>
            <div class="card-body">
                <% if(error) { %><div class="alert alert-danger"><%= error %></div><% } %>
                <% if(success) { %><div class="alert alert-success"><%= success %></div><% } %>
                
                <form action="/change-password" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu cũ:</label>
                        <input type="password" name="oldPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại" required>
                        <small class="text-muted">Để xác minh danh tính</small>
                    </div>
                    
                    <hr>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới:</label>
                        <input type="password" name="newPassword" class="form-control" placeholder="Nhập mật khẩu mới" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Xác nhận mật khẩu mới:</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Xác nhận mật khẩu mới" required>
                    </div>
                    
                    <button type="submit" class="btn btn-warning w-100 mb-2">
                        <i class="fas fa-key"></i> Đổi mật khẩu
                    </button>
                </form>
                
                <hr>
                <div class="text-center">
                    <a href="/profile" class="text-decoration-none">
                        <i class="fas fa-arrow-left"></i> Quay lại hồ sơ
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
