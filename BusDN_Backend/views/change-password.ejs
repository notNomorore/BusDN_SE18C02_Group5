<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doi mat khau | BusDN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container mt-5">
        <div class="card mx-auto shadow" style="max-width: 500px;">
            <div class="card-header bg-warning text-dark text-center">
                <h4>Doi Mat Khau</h4>
            </div>
            <div class="card-body">
                <% if (forceChange) { %>
                    <div class="alert alert-warning">
                        Day la lan dang nhap dau tien. Ban phai doi mat khau truoc khi dung he thong.
                    </div>
                <% } %>

                <% if(error) { %><div class="alert alert-danger"><%= error %></div><% } %>
                <% if(success) { %><div class="alert alert-success"><%= success %></div><% } %>

                <form action="/change-password" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mat khau cu:</label>
                        <input type="password" name="oldPassword" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mat khau moi:</label>
                        <input type="password" name="newPassword" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Xac nhan mat khau moi:</label>
                        <input type="password" name="confirmPassword" class="form-control" required>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 mb-2">
                        <i class="fas fa-key"></i> Doi mat khau
                    </button>
                </form>

                <% if (!forceChange) { %>
                    <hr>
                    <div class="text-center">
                        <a href="/profile" class="text-decoration-none">
                            <i class="fas fa-arrow-left"></i> Quay lai ho so
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
