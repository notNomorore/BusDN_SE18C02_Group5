<style>
    .users-shell {
        display: grid;
        gap: 16px;
    }

    .users-hero,
    .users-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        border: 1px solid #eef1f6;
    }

    .users-hero {
        padding: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .users-card {
        padding: 16px;
    }

    .users-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }

    .users-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
        box-shadow: 0 2px 7px rgba(0, 0, 0, 0.15);
    }
</style>

<div class="users-shell">
    <section class="users-hero">
        <div>
            <h1 class="h4 mb-1"><i class="fas fa-users-cog me-2 text-primary"></i>User Management</h1>
            <div class="text-muted small">Search by Name/Email/Phone and filter by Role</div>
        </div>
        <a href="/admin/staff/create" class="btn btn-primary btn-sm">
            <i class="fas fa-user-plus me-1"></i> Create Account
        </a>
    </section>

    <section class="users-card">
        <form method="POST" action="/admin/staff/import" enctype="multipart/form-data" class="users-grid align-items-end">
            <div>
                <label class="form-label fw-semibold mb-1">Import Bulk (Excel/CSV)</label>
                <input type="file" name="staffFile" class="form-control" accept=".csv,.xlsx,.xls" required>
                <small class="text-muted">Columns: `fullName, email, phone, role`</small>
            </div>
            <div>
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="fas fa-upload me-1"></i> Import Staff
                </button>
            </div>
        </form>
    </section>

    <section class="users-card">
        <form method="GET" action="/admin/staff" class="users-grid align-items-end">
            <div>
                <label class="form-label fw-semibold mb-1">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Name, email or phone..." value="<%= search || '' %>">
            </div>
            <div>
                <label class="form-label fw-semibold mb-1">Role</label>
                <select name="role" class="form-select">
                    <option value="ALL" <%= role === 'ALL' ? 'selected' : '' %>>All</option>
                    <option value="DRIVER" <%= role === 'DRIVER' ? 'selected' : '' %>>Driver</option>
                    <option value="CONDUCTOR" <%= role === 'CONDUCTOR' ? 'selected' : '' %>>Conductor</option>
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> Apply
                </button>
            </div>
        </form>
    </section>

    <section class="users-card p-0 overflow-hidden">
        <div class="px-3 py-2 border-bottom bg-light">
            <strong>Users (<%= users && users.length || 0 %>)</strong>
        </div>
        <% if (!users || users.length === 0) { %>
            <div class="text-center py-5 text-muted">No staff records.</div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">#</th>
                            <th>User</th>
                            <th>Login</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach((user, index) => { %>
                            <tr>
                                <td class="text-center"><%= index + 1 %></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="<%= user.avatar || '/images/default-avatar.png' %>" alt="<%= user.fullName %>" class="users-avatar">
                                        <div>
                                            <div class="fw-semibold"><%= user.fullName %></div>
                                            <small class="text-muted"><i class="fas fa-phone me-1"></i><%= user.phone || 'N/A' %></small>
                                        </div>
                                    </div>
                                </td>
                                <td><small class="text-muted"><%= user.email || user.phone || 'N/A' %></small></td>
                                <td>
                                    <span class="badge <%= user.role === 'DRIVER' ? 'bg-primary' : 'bg-info' %>">
                                        <%= user.role %>
                                    </span>
                                </td>
                                <td>
                                    <% const locked = user.status === 'LOCKED' || user.isLocked; %>
                                    <span class="badge <%= locked ? 'bg-danger' : 'bg-success' %>">
                                        <%= locked ? 'LOCKED' : 'ACTIVE' %>
                                    </span>
                                </td>
                                <td class="small text-muted"><%= new Date(user.createdAt).toLocaleDateString('vi-VN') %></td>
                                <td class="text-center">
                                    <form method="POST" action="/admin/staff/<%= user._id %>/toggle-lock" class="d-inline js-staff-lock-form"
                                        data-confirm-title="<%= (user.status === 'LOCKED' || user.isLocked) ? 'Mo khoa tai khoan?' : 'Khoa tai khoan?' %>"
                                        data-confirm-text="<%= user.email || user.phone %>"
                                        data-confirm-button="<%= (user.status === 'LOCKED' || user.isLocked) ? 'Mo khoa' : 'Khoa' %>">
                                        <button type="submit" class="btn btn-sm <%= (user.status === 'LOCKED' || user.isLocked) ? 'btn-success' : 'btn-outline-danger' %>">
                                            <i class="fas fa-<%= (user.status === 'LOCKED' || user.isLocked) ? 'lock-open' : 'lock' %> me-1"></i>
                                            <%= (user.status === 'LOCKED' || user.isLocked) ? 'Unlock' : 'Lock' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% if (totalPages && totalPages > 1) { %>
                <div class="px-3 py-3 bg-light border-top d-flex justify-content-center gap-2 flex-wrap">
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === page) { %>
                            <button class="btn btn-sm btn-primary" disabled><%= i %></button>
                        <% } else { %>
                            <a href="/admin/staff?search=<%= search || '' %>&role=<%= role || 'ALL' %>&page=<%= i %>" class="btn btn-sm btn-outline-primary"><%= i %></a>
                        <% } %>
                    <% } %>
                </div>
            <% } %>
        <% } %>
    </section>
</div>

<script>
    (function () {
        document.querySelectorAll('.js-staff-lock-form').forEach((form) => {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                if (typeof Swal === 'undefined') return form.submit();
                Swal.fire({
                    title: form.dataset.confirmTitle || 'Confirm?',
                    text: form.dataset.confirmText || '',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: form.dataset.confirmButton || 'Confirm',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });

        const onboardingInfo = <%- JSON.stringify(onboardingInfo || null) %>;
        if (!onboardingInfo || !onboardingInfo.accounts || !onboardingInfo.accounts.length || typeof Swal === 'undefined') return;
        const lines = onboardingInfo.accounts
            .map((item, idx) => `${idx + 1}. ${item.fullName} | ${item.username} | ${item.password}`)
            .join('\n');

        Swal.fire({
            icon: 'success',
            title: 'Tai khoan can gui thu cong',
            html: `<div class="text-start"><p>${onboardingInfo.summary || ''}</p><pre class="bg-light p-2 border rounded small">${lines}</pre></div>`,
            confirmButtonText: 'Da xem'
        });
    })();
</script>
