<div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-users-cog me-2 text-primary"></i> Quản lý Nhân sự</h1>
    <div class="d-flex gap-2">
        <a href="/admin/staff/create" class="btn btn-primary btn-sm">
            <i class="fas fa-user-plus me-1"></i> Tạo tài khoản
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="GET" action="/admin/staff" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    <i class="fas fa-search me-1"></i> Tìm kiếm
                </label>
                <input type="text" name="search" class="form-control" placeholder="Nhập tên hoặc email..."
                    value="<%= search || '' %>">
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    <i class="fas fa-filter me-1"></i> Vai trò
                </label>
                <select name="role" class="form-select">
                    <option value="ALL" <%= role === 'ALL' ? 'selected' : '' %>>Tất cả</option>
                    <option value="DRIVER" <%= role === 'DRIVER' ? 'selected' : '' %>>Tài xế</option>
                    <option value="CONDUCTOR" <%= role === 'CONDUCTOR' ? 'selected' : '' %>>Phụ xe</option>
                </select>
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span>
            <i class="fas fa-list me-2"></i>
            <strong>Danh sách tài khoản (<%= users && users.length || 0 %> kết quả)</strong>
        </span>
    </div>

    <div class="card-body p-0">
        <% if (!users || users.length === 0) { %>
            <div class="text-center py-5 text-muted">
                <i class="fas fa-user-slash fa-3x mb-3 opacity-25"></i>
                <p class="mb-0">
                    <% if (search || (role && role !== 'ALL')) { %>
                        Không tìm thấy tài khoản nào với tiêu chí tìm kiếm này.
                    <% } else { %>
                        Chưa có tài khoản nhân viên nào.
                    <% } %>
                </p>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th>Thông tin</th>
                            <th style="width: 150px;">Email</th>
                            <th style="width: 100px;">Vai trò</th>
                            <th style="width: 120px;">Trạng thái</th>
                            <th style="width: 100px;">Ngày tạo</th>
                            <th style="width: 100px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach((user, index) => { %>
                            <tr>
                                <td class="text-center text-muted small">
                                    <strong><%= index + 1 %></strong>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="<%= user.avatar || '/images/default-avatar.png' %>"
                                            alt="<%= user.fullName %>"
                                            class="rounded-circle border" width="40" height="40"
                                            style="object-fit: cover;">
                                        <div>
                                            <div class="fw-semibold"><%= user.fullName %></div>
                                            <% if (user.phone) { %>
                                                <small class="text-muted d-block"><i class="fas fa-phone-alt me-1"></i><%= user.phone %></small>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        <i class="fas fa-envelope me-1"></i><%= user.email %>
                                    </small>
                                </td>
                                <td>
                                    <% if (user.role === 'DRIVER') { %>
                                        <span class="badge bg-primary"><i class="fas fa-steering-wheel me-1"></i> Tài xế</span>
                                    <% } else if (user.role === 'CONDUCTOR' || user.role === 'ASSISTANT') { %>
                                        <span class="badge bg-info"><i class="fas fa-ticket-alt me-1"></i> Phụ xe</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary"><%= user.role %></span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (user.isLocked) { %>
                                        <span class="badge bg-danger"><i class="fas fa-lock me-1"></i> Đã khóa</span>
                                    <% } else if (!user.isVerified) { %>
                                        <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i> Chờ xác thực</span>
                                    <% } else { %>
                                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Hoạt động</span>
                                    <% } %>
                                </td>
                                <td class="small text-muted">
                                    <%= new Date(user.createdAt).toLocaleDateString('vi-VN') %>
                                </td>
                                <td class="text-center">
                                    <% if (user.role !== 'ADMIN') { %>
                                        <form method="POST" action="/admin/staff/<%= user._id %>/toggle-lock" class="d-inline"
                                              onsubmit="return confirm('<%= user.isLocked ? 'Mở khóa' : 'Khóa' %> tài khoản <%= user.email %>?');">
                                            <button type="submit" class="btn btn-sm <%= user.isLocked ? 'btn-success' : 'btn-outline-danger' %>">
                                                <i class="fas fa-<%= user.isLocked ? 'lock-open' : 'lock' %> me-1"></i>
                                                <%= user.isLocked ? 'Mở' : 'Khóa' %>
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="text-muted small">Quản trị viên</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <% if (totalPages && totalPages > 1) { %>
                <div class="card-footer bg-light d-flex justify-content-center gap-2 flex-wrap border-top">
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === page) { %>
                            <button class="btn btn-sm btn-primary" disabled><%= i %></button>
                        <% } else { %>
                            <a href="/admin/staff?search=<%= search || '' %>&role=<%= role || 'ALL' %>&page=<%= i %>" 
                               class="btn btn-sm btn-outline-primary"><%= i %></a>
                        <% } %>
                    <% } %>
                </div>
            <% } %>
        <% } %> </div>
</div>

<div class="card border-0 bg-light mt-3">
    <div class="card-body small text-muted">
        <i class="fas fa-info-circle me-1 text-info"></i>
        <strong>Ghi chú:</strong>
        <ul class="mb-0 mt-2">
            <li>Tài khoản bị khóa sẽ không thể đăng nhập vào ứng dụng BusDN.</li>
            <li>Để khóa hoặc mở khóa tài khoản, nhấn nút "Khóa" hoặc "Mở".</li>
            <li>Không thể thực hiện thao tác khóa đối với tài khoản Quản trị viên (Admin).</li>
        </ul>
    </div>
</div>