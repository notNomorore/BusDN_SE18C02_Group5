<% }) %>

<script>
    window.__routeBuilderStops = <%- JSON.stringify(stopOptions.map((stop) => ({
        id: String(stop._id),
        name: stop.name,
        address: stop.address || '',
        isTerminal: Boolean(stop.isTerminal),
        status: stop.status || 'ACTIVE'
    }))) %>;

    (function () {
        const stopMap = new Map((window.__routeBuilderStops || []).map((stop) => [stop.id, stop]));

        function stopText(stop) {
            if (!stop) return 'Không xác định';
            let text = stop.isTerminal ? stop.name + ' (Bến đầu/cuối)' : stop.name;
            if (stop.status && stop.status !== 'ACTIVE') text += ' [Tạm ngưng]';
            return text;
        }

        function renderBuilder(root) {
            if (!root) return;

            const hiddenInput = root.querySelector('.js-stop-sequence');
            const listEl = root.querySelector('.js-route-builder-list');
            const emptyEl = root.querySelector('.js-route-builder-empty');
            const startEl = root.querySelector('.js-start-stop');
            const endEl = root.querySelector('.js-end-stop');
            const countEl = root.querySelector('.js-stop-count');

            let sequence = [];
            try {
                sequence = JSON.parse(hiddenInput.value || '[]');
            } catch (err) {
                sequence = [];
            }

            function sync() {
                hiddenInput.value = JSON.stringify(sequence);
                listEl.innerHTML = '';

                if (!sequence.length) {
                    emptyEl.classList.remove('d-none');
                } else {
                    emptyEl.classList.add('d-none');
                }

                sequence.forEach((stopId, index) => {
                    const stop = stopMap.get(stopId);
                    if (!stop) return;

                    const item = document.createElement('li');
                    item.className = 'route-builder-item';
                    item.innerHTML = `
                        <div>
                            <strong>${index + 1}. ${stopText(stop)}</strong>
                            <small>${stop.address || 'Không có địa chỉ'}</small>
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary js-move-up" ${index === 0 ? 'disabled' : ''}>
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary js-move-down" ${index === sequence.length - 1 ? 'disabled' : ''}>
                                <i class="fas fa-arrow-down"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger js-remove-stop">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    `;

                    item.querySelector('.js-move-up').addEventListener('click', function () {
                        if (index === 0) return;
                        const prev = sequence[index - 1];
                        sequence[index - 1] = sequence[index];
                        sequence[index] = prev;
                        sync();
                    });

                    item.querySelector('.js-move-down').addEventListener('click', function () {
                        if (index >= sequence.length - 1) return;
                        const next = sequence[index + 1];
                        sequence[index + 1] = sequence[index];
                        sequence[index] = next;
                        sync();
                    });

                    item.querySelector('.js-remove-stop').addEventListener('click', function () {
                        sequence.splice(index, 1);
                        sync();
                    });

                    listEl.appendChild(item);
                });

                const startStop = stopMap.get(sequence[0] || '');
                const endStop = stopMap.get(sequence[sequence.length - 1] || '');
                startEl.textContent = stopText(startStop);
                endEl.textContent = stopText(endStop);
                countEl.textContent = String(sequence.length);
            }

            root.querySelector('.js-add-stop').addEventListener('click', function () {
                const select = root.querySelector('.js-stop-select');
                const selectedId = String(select.value || '');
                if (!selectedId) return;
                if (sequence.includes(selectedId)) {
                    window.alert('Trạm này đã có trong hành trình.');
                    return;
                }
                sequence.push(selectedId);
                sync();
            });

            sync();
        }

        document.querySelectorAll('.js-route-builder').forEach(renderBuilder);

        document.querySelectorAll('.js-route-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                const hiddenInput = form.querySelector('.js-stop-sequence');
                let sequence = [];
                try {
                    sequence = JSON.parse(hiddenInput.value || '[]');
                } catch (err) {
                    sequence = [];
                }

                if (sequence.length < 2) {
                    event.preventDefault();
                    window.alert('Vui lòng chọn ít nhất 2 trạm cho tuyến xe.');
                }
            });
        });
    })();
</script>
