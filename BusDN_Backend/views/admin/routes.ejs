                                    <option value="APPROVED" <%= route.status === 'APPROVED' ? 'selected' : '' %>>Approved</option>
                                    <option value="SCHEDULED" <%= route.status === 'SCHEDULED' ? 'selected' : '' %>>Scheduled</option>
                                    <option value="ACTIVE" <%= route.status === 'ACTIVE' ? 'selected' : '' %>>Đang hoạt động</option>
                                    <option value="REJECTED" <%= route.status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                                    <option value="SUSPENDED" <%= route.status === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
                                    <option value="INACTIVE" <%= route.status === 'INACTIVE' ? 'selected' : '' %>>Tạm ngưng</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Giá vé tháng</label>
                                <input type="number" step="1000" min="0" name="monthlyPassPrice" class="form-control" value="<%= safe(route.monthlyPassPrice) %>">
                            </div>

                            <div class="col-12">
                                <label class="form-label">Mô tả</label>
                                <textarea name="description" rows="3" class="form-control"><%= safe(route.description) %></textarea>
                            </div>

                            <div class="col-12">
                                <%- include('_route-builder', { builderId: `edit-${idx}`, stopOptions, sequence: route.outboundStops || [] }) %>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Há»§y</button>
                        <button type="submit" class="btn btn-primary">LÆ°u thay Ä‘á»•i</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% }) %>

<script>
    window.__routeBuilderStops = <%- JSON.stringify(stopOptions.map((stop) => ({
        id: String(stop._id),
        name: stop.name,
        address: stop.address || '',
        isTerminal: Boolean(stop.isTerminal),
        status: stop.status || 'ACTIVE'
    }))) %>;

    (function () {
        const stopMap = new Map((window.__routeBuilderStops || []).map((stop) => [stop.id, stop]));

        function stopText(stop) {
            if (!stop) return 'Không xác định';
            let text = stop.isTerminal ? stop.name + ' (Bến đầu/cuối)' : stop.name;
            if (stop.status && stop.status !== 'ACTIVE') text += ' [Tạm ngưng]';
            return text;
        }

        function showRouteNotice(message) {
            if (window.Swal && typeof window.Swal.fire === 'function') {
                return window.Swal.fire({
                    icon: 'warning',
                    title: 'Thông báo',
                    text: message,
                    confirmButtonText: 'Đã hiểu'
                });
            }
            window.alert(message);
            return Promise.resolve();
        }

        function renderBuilder(root) {
            if (!root) return;

            const hiddenInput = root.querySelector('.js-stop-sequence');
            const listEl = root.querySelector('.js-route-builder-list');
            const emptyEl = root.querySelector('.js-route-builder-empty');
            const startEl = root.querySelector('.js-start-stop');
            const endEl = root.querySelector('.js-end-stop');
            const countEl = root.querySelector('.js-stop-count');

            let sequence = [];
            try {
                sequence = JSON.parse(hiddenInput.value || '[]');
            } catch (err) {
                sequence = [];
            }

            function sync() {
                hiddenInput.value = JSON.stringify(sequence);
                listEl.innerHTML = '';

                emptyEl.classList.toggle('d-none', sequence.length > 0);

                sequence.forEach((stopId, index) => {
                    const stop = stopMap.get(stopId);
                    if (!stop) return;

                    const item = document.createElement('li');
                    item.className = 'route-builder-item';
                    item.innerHTML = `
                        <div>
                            <strong>${index + 1}. ${stopText(stop)}</strong>
                            <small>${stop.address || 'KhÃ´ng cÃ³ Ä‘á»‹a chá»‰'}</small>
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary js-move-up" ${index === 0 ? 'disabled' : ''}>
                                <i class="fas fa-arrow-up"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary js-move-down" ${index === sequence.length - 1 ? 'disabled' : ''}>
                                <i class="fas fa-arrow-down"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger js-remove-stop">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    `;

                    item.querySelector('.js-move-up').addEventListener('click', function () {
                        if (index === 0) return;
                        [sequence[index - 1], sequence[index]] = [sequence[index], sequence[index - 1]];
                        sync();
                    });

                    item.querySelector('.js-move-down').addEventListener('click', function () {
                        if (index >= sequence.length - 1) return;
                        [sequence[index + 1], sequence[index]] = [sequence[index], sequence[index + 1]];
                        sync();
                    });

                    item.querySelector('.js-remove-stop').addEventListener('click', function () {
                        sequence.splice(index, 1);
                        sync();
                    });

                    listEl.appendChild(item);
                });

                const startStop = stopMap.get(sequence[0] || '');
                const endStop = stopMap.get(sequence[sequence.length - 1] || '');
                startEl.textContent = stopText(startStop);
                endEl.textContent = stopText(endStop);
                countEl.textContent = String(sequence.length);
            }

            root.querySelector('.js-add-stop').addEventListener('click', function () {
                const select = root.querySelector('.js-stop-select');
                const selectedId = String(select.value || '');
                if (!selectedId) return;
                if (sequence.includes(selectedId)) {
                    showRouteNotice('Tráº¡m nÃ y Ä‘Ã£ cÃ³ trong hÃ nh trÃ¬nh.');
                    return;
                }
                sequence.push(selectedId);
                sync();
            });

            sync();
        }

        document.querySelectorAll('.js-route-builder').forEach(renderBuilder);

        document.querySelectorAll('.js-route-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                const outboundInput = form.querySelector('input[name="outboundSequence"]');
                const inboundInput = form.querySelector('input[name="inboundSequence"]');

                if (!outboundInput || !inboundInput) return;

                let outbound = [];
                let inbound = [];

                try { outbound = JSON.parse(outboundInput.value || '[]'); } catch (err) { outbound = []; }
                try { inbound = JSON.parse(inboundInput.value || '[]'); } catch (err) { inbound = []; }

                if (outbound.length < 2) {
                    event.preventDefault();
                    showRouteNotice('Vui lòng chọn ít nhất 2 trạm cho chiều đi.');
                    return;
                }

                if (inbound.length < 2) {
                    event.preventDefault();
                    showRouteNotice('Vui lòng chọn ít nhất 2 trạm cho chiều về.');
                    return;
                }

                if (String(outbound[0]) !== String(inbound[inbound.length - 1]) ||
                    String(outbound[outbound.length - 1]) !== String(inbound[0])) {
                    event.preventDefault();
                    showRouteNotice('Chiều về phải đối ứng điểm đầu/cuối với chiều đi.');
                }
            });
        });
    })();
</script>

