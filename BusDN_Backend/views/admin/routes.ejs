<%
const routeList = Array.isArray(routes) ? routes : [];
const stopOptions = Array.isArray(availableStops) ? availableStops : [];
const currentFilters = filters || {};
const currentQ = currentFilters.q || '';
const currentStatus = currentFilters.status || '';

const mainStatusOptions = [
    { value: 'DRAFT', label: 'Nháp' },
    { value: 'PENDING_REVIEW', label: 'Chờ duyệt' },
    { value: 'ACTIVE', label: 'Đang hoạt động' },
    { value: 'INACTIVE', label: 'Tạm ngưng' }
];

const routeEditStatusOptions = [
    { value: 'DRAFT', label: 'Nháp' },
    { value: 'PENDING_REVIEW', label: 'Chờ duyệt' },
    { value: 'APPROVED', label: 'Đã duyệt' },
    { value: 'SCHEDULED', label: 'Đã lên lịch' },
    { value: 'ACTIVE', label: 'Đang hoạt động' },
    { value: 'REJECTED', label: 'Từ chối' },
    { value: 'SUSPENDED', label: 'Tạm dừng' },
    { value: 'INACTIVE', label: 'Tạm ngưng' }
];

const normalizeStatus = (status) => {
    if (status === 'DRAFT') return 'DRAFT';
    if (status === 'PENDING_REVIEW') return 'PENDING_REVIEW';
    if (status === 'APPROVED') return 'APPROVED';
    if (status === 'SCHEDULED') return 'SCHEDULED';
    if (status === 'ACTIVE') return 'ACTIVE';
    if (status === 'REJECTED') return 'REJECTED';
    if (status === 'SUSPENDED') return 'SUSPENDED';
    if (status === 'INACTIVE') return 'INACTIVE';
    return 'UNKNOWN';
};

const badgeClass = (status) => {
    const s = normalizeStatus(status);
    if (s === 'DRAFT') return 'bg-secondary';
    if (s === 'PENDING_REVIEW') return 'bg-warning text-dark';
    if (s === 'APPROVED') return 'bg-info text-dark';
    if (s === 'SCHEDULED') return 'bg-primary';
    if (s === 'ACTIVE') return 'bg-success';
    if (s === 'REJECTED') return 'bg-danger';
    if (s === 'SUSPENDED') return 'bg-dark';
    if (s === 'INACTIVE') return 'bg-secondary';
    return 'bg-warning text-dark';
};

const badgeText = (status) => {
    const s = normalizeStatus(status);
    if (s === 'DRAFT') return 'Nháp';
    if (s === 'PENDING_REVIEW') return 'Chờ duyệt';
    if (s === 'APPROVED') return 'Đã duyệt';
    if (s === 'SCHEDULED') return 'Đã lên lịch';
    if (s === 'ACTIVE') return 'Đang hoạt động';
    if (s === 'REJECTED') return 'Từ chối';
    if (s === 'SUSPENDED') return 'Tạm dừng';
    if (s === 'INACTIVE') return 'Tạm ngưng';
    return 'Chưa có trạng thái';
};

const fmtDistance = (v) => (v || v === 0) ? `${v} km` : '-';
const fmtMoney = (v) => (v === null || v === undefined || v === '') ? '-' : `${Number(v).toLocaleString('vi-VN')} đ`;
const fmtOpTime = (r) => {
    const s = r && r.operationTime && r.operationTime.start ? r.operationTime.start : '';
    const e = r && r.operationTime && r.operationTime.end ? r.operationTime.end : '';
    return (s && e) ? `${s} - ${e}` : '-';
};
const timeValue = (r, key) => (r && r.operationTime && r.operationTime[key]) ? r.operationTime[key] : '';
const safe = (v) => (v === null || v === undefined) ? '' : v;
const stopLabel = (stop) => {
    if (!stop) return 'Chưa xác định';
    return stop.isTerminal ? `${stop.name} (Bến đầu/cuối)` : stop.name;
};
%>

<style>
    .route-path {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .route-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #eef4ff;
        color: #18407a;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .route-builder {
        border: 1px dashed #ced4da;
        border-radius: 16px;
        padding: 16px;
        background: #fafbfc;
    }

    .route-builder-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 10px;
        max-height: 280px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .route-builder-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        background: #fff;
        padding: 12px 14px;
    }

    .route-builder-item strong {
        display: block;
    }

    .route-builder-item small {
        color: #6c757d;
    }

    .route-builder-empty {
        border: 1px dashed #ced4da;
        border-radius: 12px;
        padding: 18px;
        text-align: center;
        color: #6c757d;
        background: #fff;
    }

    .route-points {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .route-point-card {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 12px 14px;
        background: #fff;
    }

    .route-point-card .label {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .route-modal .modal-content {
        max-height: calc(100vh - 2rem);
    }

    .route-modal .modal-body {
        overflow-y: auto;
        max-height: calc(100vh - 180px);
    }

    .route-modal-tabs {
        position: sticky;
        top: 0;
        z-index: 3;
        background: #fff;
        padding-top: 2px;
        padding-bottom: 8px;
        margin-bottom: 12px;
        border-bottom: 1px solid #dee2e6;
    }

    .route-modal .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 2;
        background: #fff;
        border-top: 1px solid #dee2e6;
        box-shadow: 0 -6px 16px rgba(15, 23, 42, 0.08);
    }

    .route-modal.route-modal-edit .modal-dialog {
        max-width: 1080px;
    }

    @media (max-width: 991.98px) {
        .route-points {
            grid-template-columns: 1fr;
        }

        .route-builder-list {
            max-height: 220px;
        }
    }
</style>

