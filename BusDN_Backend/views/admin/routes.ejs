<%
const routeList = Array.isArray(routes) ? routes : [];
const stopOptions = Array.isArray(availableStops) ? availableStops : [];
const currentFilters = filters || {};
const currentQ = currentFilters.q || '';
const currentStatus = currentFilters.status || '';

const normalizeStatus = (status) => {
    if (status === 'DRAFT') return 'DRAFT';
    if (status === 'PENDING_REVIEW') return 'PENDING_REVIEW';
    if (status === 'APPROVED') return 'APPROVED';
    if (status === 'SCHEDULED') return 'SCHEDULED';
    if (status === 'ACTIVE') return 'ACTIVE';
    if (status === 'REJECTED') return 'REJECTED';
    if (status === 'SUSPENDED') return 'SUSPENDED';
    if (status === 'INACTIVE') return 'INACTIVE';
    return 'UNKNOWN';
};

const badgeClass = (status) => {
    const s = normalizeStatus(status);
    if (s === 'DRAFT') return 'bg-secondary';
    if (s === 'PENDING_REVIEW') return 'bg-warning text-dark';
    if (s === 'APPROVED') return 'bg-info text-dark';
    if (s === 'SCHEDULED') return 'bg-primary';
    if (s === 'ACTIVE') return 'bg-success';
    if (s === 'REJECTED') return 'bg-danger';
    if (s === 'SUSPENDED') return 'bg-dark';
    if (s === 'INACTIVE') return 'bg-secondary';
    return 'bg-warning text-dark';
};

const badgeText = (status) => {
    const s = normalizeStatus(status);
    if (s === 'DRAFT') return 'Draft';
    if (s === 'PENDING_REVIEW') return 'Pending Review';
    if (s === 'APPROVED') return 'Approved';
    if (s === 'SCHEDULED') return 'Scheduled';
    if (s === 'ACTIVE') return 'Đang hoạt động';
    if (s === 'REJECTED') return 'Rejected';
    if (s === 'SUSPENDED') return 'Suspended';
    if (s === 'INACTIVE') return 'Tạm ngưng';
    return 'Chưa có trạng thái';
};

const fmtDistance = (v) => (v || v === 0) ? `${v} km` : '-';
const fmtMoney = (v) => (v === null || v === undefined || v === '') ? '-' : `${Number(v).toLocaleString('vi-VN')} đ`;
const fmtOpTime = (r) => {
    const s = r && r.operationTime && r.operationTime.start ? r.operationTime.start : '';
    const e = r && r.operationTime && r.operationTime.end ? r.operationTime.end : '';
    return (s && e) ? `${s} - ${e}` : '-';
};
const timeValue = (r, key) => (r && r.operationTime && r.operationTime[key]) ? r.operationTime[key] : '';
const safe = (v) => (v === null || v === undefined) ? '' : v;
const stopLabel = (stop) => {
    if (!stop) return 'Chưa xác định';
    return stop.isTerminal ? `${stop.name} (Bến đầu/cuối)` : stop.name;
};
%>

<style>
    .route-path {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .route-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #eef4ff;
        color: #18407a;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .route-builder {
        border: 1px dashed #ced4da;
        border-radius: 16px;
        padding: 16px;
        background: #fafbfc;
    }

    .route-builder-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 10px;
    }

    .route-builder-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        background: #fff;
        padding: 12px 14px;
    }

    .route-builder-item strong {
        display: block;
    }

    .route-builder-item small {
        color: #6c757d;
    }

    .route-builder-empty {
        border: 1px dashed #ced4da;
        border-radius: 12px;
        padding: 18px;
        text-align: center;
        color: #6c757d;
        background: #fff;
    }

    .route-points {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .route-point-card {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 12px 14px;
        background: #fff;
    }

    .route-point-card .label {
        color: #6c757d;
        font-size: 0.85rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">Quản lý Tuyến xe</h2>

    <div class="d-flex gap-2">
        <a href="/admin/stops" class="btn btn-outline-info">
            <i class="fas fa-map-marker-alt"></i> Quản lý Trạm dừng
        </a>

        <a href="/admin/routes/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Tuyến Mới
        </a>
    </div>
</div>

<% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
<% } %>

<% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
<% } %>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="GET" action="/admin/routes">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Tìm tuyến</label>
                    <input type="text" name="q" class="form-control"
                        placeholder="Nhập mã tuyến, tên tuyến hoặc mô tả..."
                        value="<%= currentQ %>">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="DRAFT" <%= currentStatus === 'DRAFT' ? 'selected' : '' %>>Draft</option>
                        <option value="PENDING_REVIEW" <%= currentStatus === 'PENDING_REVIEW' ? 'selected' : '' %>>Pending Review</option>
                        <option value="APPROVED" <%= currentStatus === 'APPROVED' ? 'selected' : '' %>>Approved</option>
                        <option value="SCHEDULED" <%= currentStatus === 'SCHEDULED' ? 'selected' : '' %>>Scheduled</option>
                        <option value="ACTIVE" <%= currentStatus === 'ACTIVE' ? 'selected' : '' %>>Đang hoạt động</option>
                        <option value="REJECTED" <%= currentStatus === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                        <option value="SUSPENDED" <%= currentStatus === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
                        <option value="INACTIVE" <%= currentStatus === 'INACTIVE' ? 'selected' : '' %>>Tạm ngưng</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Lọc
                    </button>
                    <a href="/admin/routes" class="btn btn-light border w-100">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Số hiệu</th>
                        <th>Tên tuyến</th>
                        <th>Điểm đầu</th>
                        <th>Điểm cuối</th>
                        <th>Trạm đi qua</th>
                        <th>Giờ hoạt động</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!routeList.length) { %>
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Chưa có tuyến nào trong hệ thống.</td>
                        </tr>
                    <% } %>

                    <% routeList.forEach((route, idx) => { %>
                        <tr>
                            <td>
                                <span class="badge bg-primary fs-6"><%= safe(route.routeNumber) %></span>
                            </td>
                            <td>
                                <strong><%= safe(route.name) %></strong>
                                <div class="small text-muted"><%= fmtDistance(route.distance) %> · <%= fmtMoney(route.monthlyPassPrice) %></div>
                            </td>
                            <td><%= stopLabel(route.startStop) %></td>
                            <td><%= stopLabel(route.endStop) %></td>
                            <td>
                                <div><strong><%= route.stopCount || 0 %></strong> trạm</div>
                                <div class="small text-muted">
                                    <%= (route.outboundStops || []).slice(0, 3).map((stop) => stop.name).join(' → ') %>
                                    <%= (route.outboundStops || []).length > 3 ? ' ...' : '' %>
                                </div>
                            </td>
                            <td><%= fmtOpTime(route) %></td>
                            <td>
                                <span class="badge <%= badgeClass(route.status) %>"><%= badgeText(route.status) %></span>
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-info"
                                    data-bs-toggle="modal"
                                    data-bs-target="#detailRouteModal-<%= idx %>"
                                    title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editRouteModal-<%= idx %>"
                                    title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i>
                                </button>

                                <% if (route.status === 'ACTIVE') { %>
                                    <form action="/admin/routes/<%= route._id %>/deactivate"
                                        method="POST" class="d-inline js-confirm-form"
                                        data-confirm-title="Tạm ngưng tuyến <%= safe(route.routeNumber) %>?"
                                        data-confirm-text="Sau khi tạm ngưng, tuyến sẽ không thể dùng để điều phối lịch mới cho đến khi kích hoạt lại."
                                        data-confirm-icon="warning"
                                        data-confirm-button="Xác nhận tạm ngưng"
                                        data-cancel-button="Hủy">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Tạm ngưng">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    </form>
                                <% } else if (route.status === 'INACTIVE') { %>
                                    <form action="/admin/routes/<%= route._id %>/activate"
                                        method="POST" class="d-inline js-confirm-form"
                                        data-confirm-title="Kích hoạt lại tuyến <%= safe(route.routeNumber) %>?"
                                        data-confirm-text="Tuyến sẽ được phép sử dụng lại trong điều phối lịch."
                                        data-confirm-icon="question"
                                        data-confirm-button="Kích hoạt lại"
                                        data-cancel-button="Hủy">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Kích hoạt lại">
                                            <i class="fas fa-rotate-left"></i>
                                        </button>
                                    </form>
                                <% } else { %>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Workflow status">
                                        <i class="fas fa-lock"></i>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

