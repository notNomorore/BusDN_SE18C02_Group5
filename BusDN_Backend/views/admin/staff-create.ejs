<div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-user-plus me-2 text-primary"></i> Tao Tai Khoan Nhan Vien</h1>
    <a href="/admin/staff" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i> Quay lai danh sach
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">
                <i class="fas fa-id-card me-2"></i> Thong tin tai khoan moi
            </div>
            <div class="card-body p-4">
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <% if (success) { %>
                    <div class="alert alert-success"><%= success %></div>
                <% } %>

                <form method="POST" action="/admin/staff/create">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ho va ten <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" placeholder="VD: Nguyen Van A" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email (optional)</label>
                        <input type="text" name="email" id="staffEmail" class="form-control" placeholder="email@example.com" list="emailSuggestions" autocomplete="off">
                        <datalist id="emailSuggestions"></datalist>
                        <div class="form-text">Neu khong co email, co the tao bang so dien thoai.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">So dien thoai (optional)</label>
                        <input type="tel" name="phone" class="form-control" placeholder="0xxx xxx xxx">
                        <div class="form-text">Can it nhat email hoac so dien thoai.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Vai tro <span class="text-danger">*</span></label>
                        <select name="role" class="form-select" required>
                            <option value="DRIVER">Tai xe</option>
                            <option value="CONDUCTOR">Phu xe</option>
                        </select>
                    </div>

                    <div class="alert alert-info small">
                        Mat khau tam thoi se duoc sinh tu dong (8-10 ky tu bao gom chu hoa, chu thuong, so va ky tu dac biet).
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-user-plus me-2"></i> Tao tai khoan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const emailInput = document.getElementById('staffEmail');
        const datalist = document.getElementById('emailSuggestions');

        if (!emailInput || !datalist) return;

        emailInput.addEventListener('input', function () {
            const value = (emailInput.value || '').trim();
            datalist.innerHTML = '';

            if (!value || value.includes('@')) return;

            const option = document.createElement('option');
            option.value = `${value}@gmail.com`;
            datalist.appendChild(option);
        });
    })();
</script>
