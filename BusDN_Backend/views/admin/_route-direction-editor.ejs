<%
const directionStops = Array.isArray(stops) ? stops : [];
const directionKey = directionName;
const directionLabel = directionTitle;
const directionHelpText = directionDescription || 'Quản lý danh sách trạm theo đúng thứ tự xe đi qua.';
const datalistId = `stop-search-options-${directionKey}`;
%>

<div class="card shadow-sm h-100 route-direction-editor" data-direction="<%= directionKey %>">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h5 class="mb-1"><%= directionLabel %></h5>
                <div class="text-muted small"><%= directionHelpText %></div>
            </div>
            <span class="badge text-bg-light border">Số trạm: <span class="js-stop-count"><%= directionStops.length %></span></span>
        </div>

        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-7">
                <label class="form-label">Tìm trạm</label>
                <input type="text" class="form-control js-stop-search" list="<%= datalistId %>" placeholder="Nhập tên trạm hoặc địa chỉ...">
                <datalist id="<%= datalistId %>">
                    <% availableStops.forEach((stop) => { %>
                        <option value="<%= stop.name %><%= stop.address ? ` · ${stop.address}` : '' %><%= stop.status !== 'ACTIVE' ? ' · Tạm ngưng' : '' %>"></option>
                    <% }) %>
                </datalist>
                <input type="hidden" class="js-stop-selected-id" value="">
                <div class="form-text js-stop-selected-text">Chưa chọn trạm.</div>
            </div>
            <div class="col-md-3 d-grid">
                <button type="button" class="btn btn-outline-primary js-add-stop">
                    <i class="fas fa-plus"></i> Thêm trạm
                </button>
            </div>
            <div class="col-md-2 d-grid">
                <button type="button" class="btn btn-outline-secondary js-open-stop-create-modal">
                    <i class="fas fa-map-marker-alt"></i> Trạm mới
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 46%">Trạm</th>
                        <th style="width: 18%">Phút từ đầu</th>
                        <th style="width: 18%">Km từ đầu</th>
                        <th style="width: 18%">Tác vụ</th>
                    </tr>
                </thead>
                <tbody class="js-stop-table-body"></tbody>
            </table>
        </div>

        <div class="route-direction-empty js-stop-empty <%= directionStops.length ? 'd-none' : '' %>">
            Chưa có trạm nào trong hành trình.
        </div>

        <input
            type="hidden"
            name="<%= directionKey %>StopsJson"
            class="js-direction-json"
            value='<%- JSON.stringify(directionStops) %>'>
    </div>
</div>
