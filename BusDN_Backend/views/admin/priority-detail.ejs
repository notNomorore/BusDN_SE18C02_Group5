

<style>
    .detail-container {
        max-width: 1000px;
        margin: 20px auto;
        padding: 0 15px;
    }

    .detail-header {
        background: white;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-info h2 {
        margin: 0 0 10px 0;
        color: #003366;
    }

    .header-info p {
        margin: 0;
        color: #666;
        font-size: 14px;
    }

    .header-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .header-badge.pending {
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffc107;
    }

    .header-badge.approved {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #28a745;
    }

    .header-badge.rejected {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #dc3545;
    }

    .detail-card {
        background: white;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .card-title {
        font-size: 18px;
        font-weight: 700;
        color: #003366;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #003366;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-item {
        padding: 15px;
        background-color: #f9f9f9;
        border-radius: 5px;
        border-left: 4px solid #003366;
    }

    .info-label {
        font-size: 12px;
        color: #999;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .info-value {
        font-size: 16px;
        color: #333;
        font-weight: 500;
    }

    .document-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .document-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        background: #f9f9f9;
    }

    .document-image {
        width: 100%;
        height: 200px;
        background-color: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        cursor: pointer;
    }

    .document-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s;
    }

    .document-image:hover img {
        transform: scale(1.05);
    }

    .document-info {
        padding: 15px;
        text-align: center;
    }

    .document-name {
        font-weight: 600;
        color: #333;
        margin-bottom: 10px;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .action-btn {
        padding: 6px 12px;
        border: none;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.3s;
    }

    .action-btn.view {
        background-color: #007bff;
        color: white;
    }

    .action-btn.view:hover {
        background-color: #0056b3;
    }

    .action-btn.download {
        background-color: #6c757d;
        color: white;
    }

    .action-btn.download:hover {
        background-color: #5a6268;
    }

    .action-section {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 30px;
    }

    .action-section .btn {
        padding: 12px 30px;
        border: none;
        border-radius: 5px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
    }

    .action-section .btn-success {
        background-color: #28a745;
        color: white;
    }

    .action-section .btn-success:hover {
        background-color: #20c997;
        transform: translateY(-2px);
    }

    .action-section .btn-danger {
        background-color: #dc3545;
        color: white;
    }

    .action-section .btn-danger:hover {
        background-color: #c82333;
        transform: translateY(-2px);
    }

    .action-section .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

    .action-section .btn-secondary:hover {
        background-color: #5a6268;
    }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .modal.show {
        display: flex;
    }

    .modal-content {
        background-color: white;
        border-radius: 10px;
        max-width: 90%;
        max-height: 90vh;
        overflow: auto;
        position: relative;
    }

    .modal-image {
        width: 100%;
        height: auto;
        max-height: 80vh;
    }

    .modal-close {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 28px;
        font-weight: bold;
        color: #999;
        cursor: pointer;
        background-color: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
    }

    .modal-close:hover {
        color: #000;
        background-color: white;
    }

    @media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }

        .document-grid {
            grid-template-columns: 1fr;
        }

        .action-section {
            flex-direction: column;
        }

        .action-section .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="detail-container">
    <!-- Header -->
    <div class="detail-header">
        <div class="header-info">
            <h2>
                <i class="fas fa-user me-2"></i> <%= profile.userId.fullName %>
            </h2>
            <p><%= profile.userId.email %></p>
        </div>
        <div>
            <span class="header-badge <%= profile.status %>">
                <% if (profile.status === 'pending') { %>
                    <i class="fas fa-clock me-2"></i> Chờ duyệt
                <% } else if (profile.status === 'approved') { %>
                    <i class="fas fa-check-circle me-2"></i> Đã duyệt
                <% } else { %>
                    <i class="fas fa-times-circle me-2"></i> Từ chối
                <% } %>
            </span>
        </div>
    </div>

    <!-- Profile Information -->
    <div class="detail-card">
        <div class="card-title"><i class="fas fa-id-card me-2"></i> Thông tin hồ sơ</div>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Nhóm ưu tiên</div>
                <div class="info-value"><%= profile.category %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Số giấy tờ</div>
                <div class="info-value"><%= profile.idNumber %></div>
            </div>
            <div class="info-item">
                <div class="info-label">Trạng thái</div>
                <div class="info-value" style="color: <%= profile.status === 'approved' ? '#28a745' : profile.status === 'pending' ? '#ffc107' : '#dc3545' %>;">
                    <%= profile.status === 'approved' ? 'ĐÃ DUYỆT' : profile.status === 'rejected' ? 'TỪ CHỐI' : 'CHỜ DUYỆT' %>
                </div>
            </div>
            <div class="info-item">
                <div class="info-label">Ngày gửi</div>
                <div class="info-value"><%= new Date(profile.createdAt).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
            </div>
            <% if (profile.expiryDate) { %>
                <div class="info-item">
                    <div class="info-label">Ngày hết hạn</div>
                    <div class="info-value"><%= new Date(profile.expiryDate).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
                </div>
            <% } %>
            <% if (profile.rejectionReason) { %>
                <div class="info-item">
                    <div class="info-label">Lý do từ chối</div>
                    <div class="info-value" style="color: #dc3545;"><%= profile.rejectionReason %></div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Documents -->
    <div class="detail-card">
        <div class="card-title"><i class="fas fa-file-image me-2"></i> Tài liệu đã tải lên</div>
        <div class="document-grid">
            <!-- ID Card Front -->
            <div class="document-card">
                <div class="document-image" onclick="openModal('<%= profile.idCardImageFront %>')">
                    <img src="<%= profile.idCardImageFront %>" alt="ID Front">
                </div>
                <div class="document-info">
                    <div class="document-name">CCCD/CMND - Mặt trước</div>
                    <div class="action-buttons">
                        <button class="action-btn view" onclick="openModal('<%= profile.idCardImageFront %>')">
                            <i class="fas fa-eye"></i> Xem
                        </button>
                        <a href="<%= profile.idCardImageFront %>" download class="action-btn download">
                            <i class="fas fa-download"></i> Tải xuống
                        </a>
                    </div>
                </div>
            </div>

            <!-- ID Card Back -->
            <div class="document-card">
                <div class="document-image" onclick="openModal('<%= profile.idCardImageBack %>')">
                    <img src="<%= profile.idCardImageBack %>" alt="ID Back">
                </div>
                <div class="document-info">
                    <div class="document-name">CCCD/CMND - Mặt sau</div>
                    <div class="action-buttons">
                        <button class="action-btn view" onclick="openModal('<%= profile.idCardImageBack %>')">
                            <i class="fas fa-eye"></i> Xem
                        </button>
                        <a href="<%= profile.idCardImageBack %>" download class="action-btn download">
                            <i class="fas fa-download"></i> Tải xuống
                        </a>
                    </div>
                </div>
            </div>

            <!-- Priority Proof -->
            <div class="document-card">
                <div class="document-image" onclick="openModal('<%= profile.proofImage %>')">
                    <img src="<%= profile.proofImage %>" alt="Priority Proof">
                </div>
                <div class="document-info">
                    <div class="document-name">Giấy tờ chứng minh ưu tiên</div>
                    <div class="action-buttons">
                        <button class="action-btn view" onclick="openModal('<%= profile.proofImage %>')">
                            <i class="fas fa-eye"></i> Xem
                        </button>
                        <a href="<%= profile.proofImage %>" download class="action-btn download">
                            <i class="fas fa-download"></i> Tải xuống
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <% if (profile.status === 'pending') { %>
        <div class="detail-card">
            <div class="card-title"><i class="fas fa-tasks me-2"></i> Thao tác duyệt</div>
            <div class="action-section">
                <button class="btn btn-success" onclick="approveProfile()">
                    <i class="fas fa-check-circle"></i> Duyệt hồ sơ
                </button>
                <button class="btn btn-danger" onclick="rejectProfile()">
                    <i class="fas fa-times-circle"></i> Từ chối hồ sơ
                </button>
                <a href="/admin/priority-profiles" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    <% } else { %>
        <div class="detail-card">
            <div class="action-section">
                <a href="/admin/priority-profiles" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    <% } %>
</div>

<!-- Image Modal -->
<div class="modal" id="imageModal">
    <div class="modal-content">
        <button class="modal-close" onclick="closeModal()">&times;</button>
        <img id="modalImage" class="modal-image" src="" alt="Document">
    </div>
</div>

<!-- Approve Modal -->
<div id="approveModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: white; padding: 30px; border-radius: 8px; max-width: 400px;">
        <h3 style="margin-top: 0; color: #003366;">Duyệt hồ sơ ưu tiên</h3>
        <p>Thiết lập ngày hết hạn cho hồ sơ này, tối thiểu 2 năm kể từ ngày duyệt:</p>
        <div style="margin: 20px 0;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Ngày hết hạn</label>
            <input type="date" id="expiryDate" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button onclick="closeApproveModal()" style="padding: 8px 16px; border: none; background: #6c757d; color: white; border-radius: 4px; cursor: pointer;">Hủy</button>
            <button onclick="submitApprove()" style="padding: 8px 16px; border: none; background: #28a745; color: white; border-radius: 4px; cursor: pointer;">Duyệt</button>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: white; padding: 30px; border-radius: 8px; max-width: 400px;">
        <h3 style="margin-top: 0; color: #003366;">Từ chối hồ sơ ưu tiên</h3>
        <p>Vui lòng nhập lý do từ chối hồ sơ này:</p>
        <div style="margin: 20px 0;">
            <textarea id="rejectionReason" placeholder="Nhập lý do từ chối..." style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; min-height: 120px; font-family: inherit; font-size: 14px;"></textarea>
        </div>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button onclick="closeRejectModal()" style="padding: 8px 16px; border: none; background: #6c757d; color: white; border-radius: 4px; cursor: pointer;">Hủy</button>
            <button onclick="submitReject()" style="padding: 8px 16px; border: none; background: #dc3545; color: white; border-radius: 4px; cursor: pointer;">Từ chối</button>
        </div>
    </div>
</div>

<script>
    const profileId = '<%= profile._id %>';
    const todayDateString = new Date().toISOString().slice(0, 10);
    document.getElementById('expiryDate').min = todayDateString;

    // Image Modal
    function openModal(src) {
        document.getElementById('imageModal').classList.add('show');
        document.getElementById('modalImage').src = src;
    }

    function closeModal() {
        document.getElementById('imageModal').classList.remove('show');
    }

    window.onclick = function(event) {
        const modal = document.getElementById('imageModal');
        if (event.target == modal) {
            modal.classList.remove('show');
        }
    }

    // Approve Modal
    function approveProfile() {
        const tomorrow = new Date();
        tomorrow.setFullYear(tomorrow.getFullYear() + 2);
        const expiryInput = document.getElementById('expiryDate');
        expiryInput.min = todayDateString;
        expiryInput.valueAsDate = tomorrow;
        document.getElementById('approveModal').style.display = 'flex';
    }

    function closeApproveModal() {
        document.getElementById('approveModal').style.display = 'none';
    }

    function submitApprove() {
        const expiryDate = document.getElementById('expiryDate').value;
        if (!expiryDate) {
            Swal.fire({ icon: 'warning', title: 'Thiếu dữ liệu', text: 'Vui lòng chọn ngày hết hạn' });
            return;
        }
        if (expiryDate < todayDateString) {
            alert('Ngày hết hạn không được ở trong quá khứ');
            return;
        }

        fetch(`/admin/priority-profiles/${profileId}/approve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ expiryDate })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đã duyệt hồ sơ thành công' })
                    .then(() => { location.href = '/admin/priority-profiles'; });
            } else {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: data.error || 'Duyệt hồ sơ thất bại' });
            }
        })
        .catch(err => Swal.fire({ icon: 'error', title: 'Lỗi', text: String(err) }));
    }

    // Reject Modal
    function rejectProfile() {
        document.getElementById('rejectModal').style.display = 'flex';
    }

    function closeRejectModal() {
        document.getElementById('rejectModal').style.display = 'none';
    }

    function submitReject() {
        const rejectionReason = document.getElementById('rejectionReason').value;
        if (!rejectionReason) {
            Swal.fire({ icon: 'warning', title: 'Thiếu dữ liệu', text: 'Vui lòng nhập lý do từ chối' });
            return;
        }

        fetch(`/admin/priority-profiles/${profileId}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rejectionReason })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đã từ chối hồ sơ thành công' })
                    .then(() => { location.href = '/admin/priority-profiles'; });
            } else {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: data.error || 'Từ chối hồ sơ thất bại' });
            }
        })
        .catch(err => Swal.fire({ icon: 'error', title: 'Lỗi', text: String(err) }));
    }
</script>
