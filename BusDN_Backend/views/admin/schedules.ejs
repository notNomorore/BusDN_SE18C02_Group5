<script>
(() => {
    const input = document.getElementById('scheduleDateFilter');
    if (!input) return;
    const todayDateString = new Date().toISOString().slice(0, 10);
    input.min = todayDateString;
    if (input.value && input.value < todayDateString) {
        input.value = todayDateString;
    }
})();
</script>
