<style>
    .priority-wrap {
        background: #f5f8fc;
        border-radius: 14px;
        padding: 16px;
    }

    .priority-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .priority-chip {
        border-radius: 999px;
        padding: 6px 12px;
        border: 1px solid #d4d9e2;
        text-decoration: none;
        color: #243042;
        font-weight: 600;
    }

    .priority-chip.active {
        background: #1d4ed8;
        color: #fff;
        border-color: #1d4ed8;
    }
</style>

<div class="priority-wrap">
    <div class="priority-header">
        <h2 class="h4 mb-0"><i class="fas fa-id-card me-2 text-primary"></i>Hồ sơ ưu tiên</h2>
        <div class="d-flex gap-2">
            <a href="/admin/priority-profiles" class="priority-chip <%= currentStatus === 'pending' ? 'active' : '' %>">Chờ duyệt</a>
            <a href="/admin/priority-profiles?status=approved" class="priority-chip <%= currentStatus === 'approved' ? 'active' : '' %>">Đã duyệt</a>
            <a href="/admin/priority-profiles?status=rejected" class="priority-chip <%= currentStatus === 'rejected' ? 'active' : '' %>">Từ chối</a>
        </div>
    </div>

    <% if (!profiles || profiles.length === 0) { %>
        <div class="text-center text-muted py-5">Không tìm thấy hồ sơ nào.</div>
    <% } else { %>
        <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Người dùng</th>
                        <th>Nhóm ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Ngày gửi</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% profiles.forEach(profile => { %>
                        <tr>
                            <td>
                                <div class="fw-semibold"><%= profile.userId?.fullName || 'Không có dữ liệu' %></div>
                                <small class="text-muted"><%= profile.userId?.email || profile.userId?.phone || 'Không có dữ liệu' %></small>
                            </td>
                            <td><%= profile.category %></td>
                            <td>
                                <span class="badge <%= profile.status === 'approved' ? 'bg-success' : profile.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark' %>">
                                    <%= profile.status === 'approved' ? 'ĐÃ DUYỆT' : profile.status === 'rejected' ? 'TỪ CHỐI' : 'CHỜ DUYỆT' %>
                                </span>
                            </td>
                            <td><small class="text-muted"><%= new Date(profile.createdAt).toLocaleDateString('vi-VN') %></small></td>
                            <td class="text-center">
                                <a href="/admin/priority-profiles/<%= profile._id %>" class="btn btn-outline-primary btn-sm">Xem</a>
                                <% if (profile.status === 'pending') { %>
                                    <button class="btn btn-success btn-sm" onclick="approveProfile('<%= profile._id %>')">Duyệt</button>
                                    <button class="btn btn-danger btn-sm" onclick="rejectProfile('<%= profile._id %>')">Từ chối</button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<div id="approveModal" class="modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Duyệt hồ sơ</h5>
                <button type="button" class="btn-close" onclick="closeApproveModal()"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Ngày hết hạn ưu tiên (ít nhất 2 năm kể từ hôm nay)</label>
                <input type="date" id="expiryDate" class="form-control">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeApproveModal()">Hủy</button>
                <button type="button" class="btn btn-success" onclick="submitApprove()">Duyệt</button>
            </div>
        </div>
    </div>
</div>

<div id="rejectModal" class="modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Từ chối hồ sơ</h5>
                <button type="button" class="btn-close" onclick="closeRejectModal()"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Lý do từ chối</label>
                <textarea id="rejectionReason" class="form-control" rows="4"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeRejectModal()">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="submitReject()">Từ chối</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentProfileId = null;
    const expiryDateInput = document.getElementById('expiryDate');
    const todayDateString = new Date().toISOString().slice(0, 10);
    if (expiryDateInput) expiryDateInput.min = todayDateString;

    function getMinExpiryDateString() {
        const d = new Date();
        d.setFullYear(d.getFullYear() + 2);
        return d.toISOString().split('T')[0];
    }

    function approveProfile(profileId) {
        currentProfileId = profileId;
        const input = document.getElementById('expiryDate');
        const min = getMinExpiryDateString();
        input.min = min;
        input.value = min;
        document.getElementById('approveModal').style.display = 'block';
    }

    function closeApproveModal() {
        document.getElementById('approveModal').style.display = 'none';
    }

    function submitApprove() {
        const expiryDate = document.getElementById('expiryDate').value;
        if (!expiryDate) return;
        fetch(`/admin/priority-profiles/${currentProfileId}/approve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ expiryDate })
        })
        .then(res => res.json())
        .then((data) => {
            if (!data.success) throw new Error(data.error || 'Không thể duyệt hồ sơ');
            window.location.reload();
        })
        .catch((err) => window.Swal ? Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message }) : alert(err.message));
    }

    function rejectProfile(profileId) {
        currentProfileId = profileId;
        document.getElementById('rejectionReason').value = '';
        document.getElementById('rejectModal').style.display = 'block';
    }

    function closeRejectModal() {
        document.getElementById('rejectModal').style.display = 'none';
    }

    function submitReject() {
        const rejectionReason = document.getElementById('rejectionReason').value.trim();
        if (!rejectionReason) return;
        fetch(`/admin/priority-profiles/${currentProfileId}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rejectionReason })
        })
        .then(res => res.json())
        .then((data) => {
            if (!data.success) throw new Error(data.error || 'Không thể từ chối hồ sơ');
            window.location.reload();
        })
        .catch((err) => window.Swal ? Swal.fire({ icon: 'error', title: 'Lỗi', text: err.message }) : alert(err.message));
    }
</script>
