<style>
    /* BỌC TOÀN BỘ CSS TRONG CLASS CHA .admin-priority-wrapper */
    .admin-priority-wrapper {
        padding: 20px;
        background-color: #f4f7f6;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .admin-priority-wrapper .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .admin-priority-wrapper .page-header h1 {
        margin: 0;
        color: #003366 !important;
        /* Dùng !important để tránh bị ghi đè ngược */
        font-size: 28px;
    }

    .admin-priority-wrapper .filter-btn {
        padding: 8px 16px;
        border: 2px solid #ddd;
        background-color: white;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s;
        text-decoration: none;
        color: #333;
    }

    .admin-priority-wrapper .filter-btn.active {
        background-color: #003366;
        color: white;
        border-color: #003366;
    }

    .admin-priority-wrapper .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .admin-priority-wrapper .stat-card {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border-left: 4px solid;
    }

    /* ĐỊNH NGHĨA TABLE CÓ CLASS CHA ĐỂ KHÔNG LÀM VỠ HEADER */
    .admin-priority-wrapper table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    .admin-priority-wrapper th {
        padding: 15px;
        text-align: left;
        background-color: #f8f9fa;
        border-bottom: 2px solid #ddd;
        color: #333;
    }

    .admin-priority-wrapper td {
        padding: 15px;
        border-bottom: 1px solid #eee;
    }

    /* Modal styles */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        /* Đảm bảo nổi trên cùng */
        align-items: center;
        justify-content: center;
    }
</style>

<div class="admin-priority-wrapper">
    <div class="page-header">
        <h1><i class="fas fa-id-card me-3"></i> Priority Profile Management</h1>
    </div>

    <div style="margin-bottom: 20px;">
        <div class="filter-buttons" style="display: flex; gap: 10px;">
            <a href="/priority/admin/profiles"
                class="filter-btn <%= currentStatus === 'pending' ? 'active' : '' %>">Pending</a>
            <a href="/priority/admin/profiles?status=approved"
                class="filter-btn <%= currentStatus === 'approved' ? 'active' : '' %>">Approved</a>
            <a href="/priority/admin/profiles?status=rejected"
                class="filter-btn <%= currentStatus === 'rejected' ? 'active' : '' %>">Rejected</a>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-label">Pending</div>
            <div class="stat-value" style="font-size: 24px; font-weight: bold;">
                <%= profiles.filter(p=> p.status === 'pending').length %>
            </div>
        </div>
        <div class="stat-card" style="border-left-color: #28a745;">
            <div class="stat-label">Approved</div>
            <div class="stat-value" style="font-size: 24px; font-weight: bold;">
                <%= profiles.filter(p=> p.status === 'approved').length %>
            </div>
        </div>
    </div>

    <div class="table-responsive"
        style="background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <% if (profiles.length===0) { %>
            <p style="padding: 40px; text-align: center; color: #999;">No priority profiles found.</p>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% profiles.forEach(profile=> { %>
                            <tr>
                                <td>
                                    <strong>
                                        <%= profile.userId.fullName %>
                                    </strong><br>
                                    <small>
                                        <%= profile.userId.email %>
                                    </small>
                                </td>
                                <td>
                                    <%= profile.category %>
                                </td>
                                <td><span class="status-badge <%= profile.status %>">
                                        <%= profile.status %>
                                    </span></td>
                                <td>
                                    <div style="display: flex; gap: 5px;">
                                        <a href="/priority/admin/profiles/<%= profile._id %>" class="filter-btn"
                                            style="font-size: 12px; padding: 5px 10px;">View</a>
                                        <% if (profile.status==='pending' ) { %>
                                            <button onclick="approveProfile('<%= profile._id %>')"
                                                style="background: #28a745; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">Approve</button>
                                            <button onclick="rejectProfile('<%= profile._id %>')"
                                                style="background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">Reject</button>
                                            <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
                <% } %>
    </div>
</div>

<div id="approveModal" class="modal-overlay">
    <div style="background: white; padding: 30px; border-radius: 8px; width: 90%; max-width: 400px;">
        <h3>Set Expiry Date</h3>
        <input type="date" id="expiryDate" style="width: 100%; padding: 10px; margin: 15px 0; border: 1px solid #ddd;">
        <div style="text-align: right;">
            <button onclick="closeApproveModal()">Cancel</button>
            <button onclick="submitApprove()"
                style="background: #28a745; color: white; border: none; padding: 8px 15px; border-radius: 4px;">Submit</button>
        </div>
    </div>
</div>

<div id="rejectModal" class="modal-overlay">
    <div style="background: white; padding: 30px; border-radius: 8px; width: 90%; max-width: 400px;">
        <h3>Rejection Reason</h3>
        <textarea id="rejectionReason"
            style="width: 100%; height: 100px; padding: 10px; margin: 15px 0; border: 1px solid #ddd;"></textarea>
        <div style="text-align: right;">
            <button onclick="closeRejectModal()">Cancel</button>
            <button onclick="submitReject()"
                style="background: #dc3545; color: white; border: none; padding: 8px 15px; border-radius: 4px;">Submit</button>
        </div>
    </div>
</div>

<script>
    // Giữ nguyên phần script của bạn, chỉ thêm logic hiển thị flex cho modal
    let currentProfileId = null;
    const expiryDateInput = document.getElementById('expiryDate');
    const todayDateString = new Date().toISOString().slice(0, 10);
    if (expiryDateInput) expiryDateInput.min = todayDateString;

    function approveProfile(profileId) {
        currentProfileId = profileId;
        if (expiryDateInput && !expiryDateInput.value) {
            const defaultExpiry = new Date();
            defaultExpiry.setFullYear(defaultExpiry.getFullYear() + 2);
            expiryDateInput.value = defaultExpiry.toISOString().slice(0, 10);
        }
        document.getElementById('approveModal').style.display = 'flex';
    }
    function closeApproveModal() { document.getElementById('approveModal').style.display = 'none'; }

    function rejectProfile(profileId) {
        currentProfileId = profileId;
        document.getElementById('rejectModal').style.display = 'flex';
    }
    function closeRejectModal() { document.getElementById('rejectModal').style.display = 'none'; }

    // Các hàm fetch dữ liệu (submitApprove, submitReject) giữ nguyên như cũ...
</script>
