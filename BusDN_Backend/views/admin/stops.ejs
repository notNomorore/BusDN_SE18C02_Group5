<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<%
const stopList = Array.isArray(stops) ? stops : [];
const currentFilters = filters || {};
const currentQ = currentFilters.q || '';
const currentStatus = currentFilters.status || '';

const normalizeStatus = (status) => {
  if (status === 'ACTIVE') return 'ACTIVE';
  if (status === 'INACTIVE') return 'INACTIVE';
  return 'UNKNOWN';
};

const badgeClass = (status) => {
  const s = normalizeStatus(status);
  if (s === 'ACTIVE') return 'bg-success';
  if (s === 'INACTIVE') return 'bg-secondary';
  return 'bg-warning text-dark';
};

const badgeText = (status) => {
  const s = normalizeStatus(status);
  if (s === 'ACTIVE') return 'Đang hoạt động';
  if (s === 'INACTIVE') return 'Tạm ngưng';
  return 'Chưa có trạng thái';
};

const safe = (v) => (v === null || v === undefined) ? '' : v;
%>

<style>
  .stop-map {
    height: 280px;
    border: 1px solid #dee2e6;
    border-radius: 12px;
    overflow: hidden;
  }

  .stop-map-help {
    font-size: 0.9rem;
    color: #6c757d;
  }

  .stop-inline-toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%) translateY(16px);
    min-width: 280px;
    max-width: min(560px, calc(100vw - 32px));
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(33, 37, 41, 0.94);
    color: #fff;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.22);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 2000;
  }

  .stop-inline-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">Quản lý Trạm dừng</h2>

    <div class="d-flex gap-2">
        <a href="/admin/routes" class="btn btn-outline-secondary">
            <i class="fas fa-road"></i> Quản lý Tuyến
        </a>

        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStopModal">
            <i class="fas fa-plus"></i> Thêm Trạm Mới
        </button>
    </div>
</div>

<% if (success) { %>
<div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if (error) { %>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="GET" action="/admin/stops">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Tìm trạm</label>
                    <input type="text" name="q" class="form-control" placeholder="Nhập tên trạm hoặc địa chỉ..." value="<%= currentQ %>">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="ACTIVE" <%= currentStatus === 'ACTIVE' ? 'selected' : '' %>>Đang hoạt động</option>
                        <option value="INACTIVE" <%= currentStatus === 'INACTIVE' ? 'selected' : '' %>>Tạm ngưng</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i> Lọc</button>
                    <a href="/admin/stops" class="btn btn-light border w-100">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên trạm</th>
                        <th>Địa chỉ</th>
                        <th>Tọa độ</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!stopList.length) { %>
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có trạm dừng nào trong hệ thống.</td>
                    </tr>
                    <% } %>

                    <% stopList.forEach((stop, idx) => { %>
                    <tr>
                        <td><strong><%= safe(stop.name) %></strong></td>
                        <td><%= safe(stop.address) || '-' %></td>
                        <td><%= safe(stop.lat) %>, <%= safe(stop.lng) %></td>
                        <td><span class="badge <%= badgeClass(stop.status) %>"><%= badgeText(stop.status) %></span></td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editStopModal-<%= idx %>" title="Chỉnh sửa">
                                <i class="fas fa-edit"></i>
                            </button>

                            <% if (stop.status === 'ACTIVE') { %>
                            <form action="/admin/stops/<%= stop._id %>/deactivate" method="POST" class="d-inline js-confirm-form"
                                  data-confirm-title="Tạm ngưng trạm <%= safe(stop.name) %>?"
                                  data-confirm-text="Trạm sẽ không còn được chọn cho cấu hình tuyến mới."
                                  data-confirm-icon="warning"
                                  data-confirm-button="Xác nhận tạm ngưng"
                                  data-cancel-button="Hủy">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Tạm ngưng">
                                    <i class="fas fa-ban"></i>
                                </button>
                            </form>
                            <% } else { %>
                            <form action="/admin/stops/<%= stop._id %>/activate" method="POST" class="d-inline js-confirm-form"
                                  data-confirm-title="Kích hoạt lại trạm <%= safe(stop.name) %>?"
                                  data-confirm-text="Trạm sẽ có thể được sử dụng lại."
                                  data-confirm-icon="question"
                                  data-confirm-button="Kích hoạt lại"
                                  data-cancel-button="Hủy">
                                <button type="submit" class="btn btn-sm btn-outline-success" title="Kích hoạt lại">
                                    <i class="fas fa-rotate-left"></i>
                                </button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createStopModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form action="/admin/stops/create" method="POST" class="js-stop-location-form">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm Trạm Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-4">
                        <div class="col-lg-5">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Tên trạm *</label>
                                    <input type="text" name="name" class="form-control js-stop-name" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Địa chỉ</label>
                                    <input type="text" name="address" class="form-control js-stop-address">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Tìm địa điểm</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control js-stop-geocode-query" placeholder="Nhập địa chỉ hoặc tên địa điểm...">
                                        <button type="button" class="btn btn-outline-secondary js-stop-geocode-btn">
                                            <i class="fas fa-search-location"></i> 
                                        </button>
                                        <button type="button" class="btn btn-outline-primary js-stop-quick-fill-btn">
                                            <i class="fas fa-bolt"></i> Thêm trạm nhanh
                                        </button>
                                    </div>
                                    <div class="form-text">Chỉ tìm trong khu vực Đà Nẵng. Nút "Thêm trạm nhanh" sẽ tự điền tên trạm, địa chỉ và tọa độ từ kết quả tìm kiếm.</div>
                                    <div class="alert alert-warning d-none mt-2 mb-0 js-stop-geocode-error"></div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Vĩ độ (lat) *</label>
                                    <input type="text" name="lat" class="form-control js-stop-lat" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Kinh độ (lng) *</label>
                                    <input type="text" name="lng" class="form-control js-stop-lng" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Trạng thái</label>
                                    <select class="form-select" name="status">
                                        <option value="ACTIVE" selected>Đang hoạt động</option>
                                        <option value="INACTIVE">Tạm ngưng</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="stop-map js-stop-map"></div>
                            <div class="stop-map-help mt-2">Click để chọn vị trí. Kéo marker để tinh chỉnh tọa độ.</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Tạo trạm</button>
                </div>
            </form>
        </div>
    </div>
</div>

