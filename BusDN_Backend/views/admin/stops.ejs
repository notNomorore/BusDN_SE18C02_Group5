                                    <label class="form-label">Trạng thái</label>
                                    <select class="form-select" name="status">
                                        <option value="ACTIVE" <%= stop.status === 'ACTIVE' ? 'selected' : '' %>>Đang hoạt động</option>
                                        <option value="INACTIVE" <%= stop.status === 'INACTIVE' ? 'selected' : '' %>>Tạm ngưng</option>
                                    </select>
                                </div>
