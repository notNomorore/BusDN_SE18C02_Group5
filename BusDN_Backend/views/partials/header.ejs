<header class="main-header">
    <style>
        .main-header {
            position: sticky;
            top: 0;
            z-index: 1050;
            width: 100%;
        }

        .btn-outline-clean {
            border: 1px solid rgba(255, 255, 255, 0.7);
            color: #fff;
            background: transparent;
            border-radius: 999px;
            padding: 6px 16px;
            font-weight: 600;
            transition: all 0.25s ease;
        }

        .btn-outline-clean:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
        }
    </style>
</head>
<body>
<header class="main-header">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #003366; padding: 15px 0; border-bottom: 3px solid #ffc107;">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/home">
                <i class="fa-solid fa-bus text-warning"></i> BusDN
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="/home">Trang ch&#7911;</a></li>
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="/route-lookup">Tra c&#7913;u tuy&#7871;n</a></li>
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="#">Tin t&#7913;c</a></li>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item"><a class="nav-link text-white mx-2" href="/passenger/my-tickets">V&#233; c&#7911;a t&#244;i</a></li>
                    <% } %>
                </ul>

                <% if (typeof user !== 'undefined' && user) { %>
                <div class="d-flex align-items-center gap-2 ms-lg-3 flex-wrap flex-lg-nowrap">
                    <div class="dropdown">
                        <a href="#" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false"
                            class="dropdown-toggle text-decoration-none d-flex align-items-center" style="gap:10px; padding:4px 12px 4px 4px; border-radius:999px; background:rgba(255,255,255,.10); border:1px solid rgba(255,255,255,.18); color:#fff !important;">

                            <img src="<%= user.avatar ? user.avatar : 'https://via.placeholder.com/40x40?text=U' %>"
                                 alt="Avatar" width="38" height="38" style="object-fit:cover; border-radius:50%; border:2px solid #ffd34d;">

                            <span class="fw-bold d-none d-md-inline" style="max-width:120px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                <%= user.fullName %>
                            </span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="width:260px; border-radius:14px; padding:8px; margin-top:10px;">
                            <li><a class="dropdown-item py-2" href="/profile"><i class="fa-solid fa-user me-2 text-primary"></i>H&#7891; s&#417; c&#225; nh&#226;n</a></li>
                            <li><a class="dropdown-item py-2" href="/priority/register"><i class="fa-solid fa-id-card me-2 text-success"></i>&#272;&#259;ng k&#253; &#432;u ti&#234;n</a></li>
                            <li><a class="dropdown-item py-2" href="/passenger/my-tickets"><i class="fa-solid fa-ticket me-2 text-warning"></i>V&#233; c&#7911;a t&#244;i</a></li>
                            <li><a class="dropdown-item py-2" href="/passenger/passes/monthly"><i class="fa-solid fa-credit-card me-2 text-info"></i>Mua v&#233; th&#225;ng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger py-2" href="/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>&#272;&#259;ng xu&#7845;t</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/login" class="btn btn-outline-light btn-sm px-3">&#272;&#259;ng nh&#7853;p</a>
                        <a href="/register" class="btn btn-warning btn-sm fw-bold px-3">&#272;&#259;ng k&#253;</a>
                    </div>
                <% } %>
            </div>
        </div>
    </nav>
</header>
