<!-- Header Wallet Auto Refresh -->
<script>
    (function () {
        const desktopEl = document.getElementById('headerWalletBalanceText');
        const mobileEl = document.getElementById('headerWalletBalanceTextMobile');
        const loadingEl = document.getElementById('headerWalletLoading');

        // Nếu chưa đăng nhập / không có wallet UI thì bỏ qua
        if (!desktopEl && !mobileEl) return;

        let isFetching = false;
        let timer = null;

        function normalizeBalanceText(data) {
            if (!data) return null;

            // Nếu backend trả text sẵn, tránh bị "đ đ"
            if (typeof data.walletBalanceText === 'string') {
                const t = data.walletBalanceText.trim();
                return /đ$/i.test(t) ? t : (t + ' đ');
            }

            if (typeof data.walletBalance !== 'undefined') {
                return Number(data.walletBalance || 0).toLocaleString('vi-VN') + ' đ';
            }

            return null;
        }

        function pulse(el) {
            if (!el) return;
            el.style.transform = 'scale(1.04)';
            setTimeout(() => { el.style.transform = 'scale(1)'; }, 180);
        }

        async function fetchHeaderWalletBalance() {
            if (isFetching) return;
            isFetching = true;
            if (loadingEl) loadingEl.classList.remove('d-none');

            try {
                const res = await fetch('/passenger/wallet/balance', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store',
                    credentials: 'same-origin'
                });

                if (!res.ok) return;
                const data = await res.json();
                if (!data || data.ok === false) return;

                const nextText = normalizeBalanceText(data);
                if (!nextText) return;

                if (desktopEl) {
                    const prevText = (desktopEl.textContent || '').trim();
                    desktopEl.textContent = nextText;
                    if (prevText && prevText !== nextText) pulse(desktopEl);
                }

                if (mobileEl) mobileEl.textContent = nextText;

            } catch (e) {
                // silent fail
            } finally {
                if (loadingEl) loadingEl.classList.add('d-none');
                isFetching = false;
            }
        }

        fetchHeaderWalletBalance();
        timer = setInterval(fetchHeaderWalletBalance, 5000);

        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) fetchHeaderWalletBalance();
        });

        window.addEventListener('beforeunload', function () {
            if (timer) clearInterval(timer);
        });
    })();
</script>
