<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BusDN - Hệ thống vé xe buýt</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .main-header {
            position: sticky;
            top: 0;
            z-index: 1050;
            width: 100%;
        }

        .btn-outline-clean {
            border: 1px solid rgba(255, 255, 255, 0.7);
            color: #fff;
            background: transparent;
            border-radius: 999px;
            padding: 6px 16px;
            font-weight: 600;
            transition: all 0.25s ease;
        }

        .btn-outline-clean:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
        }
    </style>
</head>
<body>
<header class="main-header">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #003366; padding: 15px 0; border-bottom: 3px solid #ffc107;">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/home">
                <i class="fa-solid fa-bus text-warning"></i> BusDN
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="/home">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="/route-lookup">Tra cứu tuyến</a></li>
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="#">Tin tức</a></li>
                </ul>

                <% const currentUser = (typeof locals !== 'undefined' && locals.user) ? locals.user : null; %>
                <% if (!currentUser) { %>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/login" class="btn btn-outline-clean btn-sm">Login</a>
                        <a href="/register" class="btn btn-outline-clean btn-sm">Register</a>
                    </div>
                <% } else { %>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/admin/dashboard" class="btn btn-outline-clean btn-sm">Dashboard</a>
                        <a href="/profile" class="btn btn-outline-clean btn-sm">Profile</a>
                        <a href="/logout" class="btn btn-outline-clean btn-sm">Logout</a>
                    </div>
                <% } %>
            </div>
        </div>
    </nav>
</header>
