<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BusDN - Hệ thống vé xe buýt</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Đảm bảo Header luôn ở trên cùng và không bị ảnh hưởng bởi nội dung dưới */
        .main-header {
            position: sticky;
            top: 0;
            z-index: 1050; /* Cao hơn mọi thứ trong trang */
            width: 100%;
        }
    </style>
</head>
<body>

<header class="main-header">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #003366; padding: 15px 0; border-bottom: 3px solid #ffc107;">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/home">
                <i class="fa-solid fa-bus text-warning"></i> BusDN
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="/home">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="/route-lookup">Tra cứu tuyến</a></li>
                    <li class="nav-item"><a class="nav-link text-white mx-2" href="#">Tin tức</a></li>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item"><a class="nav-link text-white mx-2" href="#">Vé của tôi</a></li>
                    <% } %>
                </ul>

                <div class="d-flex align-items-center">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                                id="userMenu" data-bs-toggle="dropdown">
                                <img src="<%= user.avatar ? user.avatar : 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
                                    class="rounded-circle border border-2 border-warning me-2" width="40" height="40"
                                    style="object-fit: cover;">
                                <span class="fw-bold d-none d-sm-inline">
                                    <%= user.fullName %>
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li><h6 class="dropdown-header">Tài khoản cá nhân</h6></li>
                                <li><a class="dropdown-item" href="/profile"><i class="fa-solid fa-user me-2 text-primary"></i> Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item" href="/priority/register"><i class="fa-solid fa-id-card me-2 text-success"></i> Đăng ký ưu tiên</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fa-solid fa-qrcode me-2 text-warning"></i> Mã vé QR</a></li>
                                
                                <% if (user.role === 'ADMIN') { %>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/admin/dashboard"><i class="fa-solid fa-user-shield me-2 text-danger"></i> Quản trị hệ thống</a></li>
                                <% } %>

                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <div class="auth-buttons">
                            <a href="/login" class="btn btn-outline-light me-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
</header>