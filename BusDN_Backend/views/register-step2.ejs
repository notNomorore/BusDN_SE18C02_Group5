<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - Bước 2</title>
    <style>
        body { margin:0; min-height:100vh; display:grid; place-items:center; font-family:Segoe UI,sans-serif; background:linear-gradient(140deg,#dbeafe,#e0f2fe,#eff6ff); }
        .card { width:min(560px,94vw); padding:26px; border-radius:18px; background:rgba(255,255,255,.9); border:1px solid #dbe7ff; box-shadow:0 14px 28px rgba(30,64,175,.15); }
        .title { margin:0 0 6px; color:#1d4ed8; }
        .sub { margin:0 0 16px; color:#475569; }
        input { width:100%; padding:12px; border-radius:10px; border:1px solid #cbd5e1; margin:8px 0 12px; }
        .btn { border:none; border-radius:10px; padding:11px 14px; font-weight:700; color:#fff; background:#2563eb; cursor:pointer; }
        .btn.secondary { background:#64748b; }
        .btn.success { background:#0f766e; }
        .row { display:flex; gap:10px; flex-wrap:wrap; }
        .alert { padding:10px; border-radius:10px; margin-bottom:10px; }
        .alert.error { background:#fee2e2; color:#b91c1c; }
        .alert.success { background:#dcfce7; color:#166534; }
        #phoneVerifyBox { display:none; margin-top:10px; }
        #recaptcha-container { margin:12px 0; }
        .muted { color:#64748b; font-size:13px; }
    </style>
</head>
<body>
    <div class="card">
        <h2 class="title">Bước 2: Email hoặc Số điện thoại</h2>
        <p class="sub">Nhập một trường duy nhất, hệ thống tự nhận diện loại liên hệ</p>
        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert success"><%= success %></div><% } %>

        <form id="emailForm" action="/register-step2" method="POST">
            <label>Email hoặc Số điện thoại</label>
            <input id="contactValue" name="contactValue" value="<%= contactValue || '' %>" placeholder="example@gmail.com hoặc +8490..." required>
            <div class="row">
                <button class="btn" type="submit">Tiếp tục bằng Email</button>
                <button class="btn success" type="button" id="sendPhoneOtpBtn">Xác thực số điện thoại</button>
                <a class="btn secondary" href="/register-step1" style="text-decoration:none;">Quay lại</a>
            </div>
        </form>

        <div id="phoneVerifyBox">
            <div id="recaptcha-container"></div>
            <input id="phoneOtpCode" placeholder="Nhập OTP từ SMS">
            <div class="row">
                <button class="btn success" type="button" id="verifyPhoneOtpBtn">Xác thực OTP điện thoại</button>
            </div>
            <p class="muted" id="phoneStatus"></p>
        </div>
    </div>

    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
    <script>
        const firebaseConfig = <%- JSON.stringify(firebaseConfig || {}) %>;
        const contactInput = document.getElementById('contactValue');
        const emailForm = document.getElementById('emailForm');
        const sendPhoneOtpBtn = document.getElementById('sendPhoneOtpBtn');
        const verifyPhoneOtpBtn = document.getElementById('verifyPhoneOtpBtn');
        const phoneOtpCodeInput = document.getElementById('phoneOtpCode');
        const phoneStatus = document.getElementById('phoneStatus');
        const phoneVerifyBox = document.getElementById('phoneVerifyBox');
        let confirmationResult = null;

        function detectType(value) {
            return value.includes('@') ? 'EMAIL' : 'PHONE';
        }

        async function checkContact(contactValue) {
            const res = await fetch('/register-step2/check-contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contactValue })
            });
            return res.json();
        }

        emailForm.addEventListener('submit', async (event) => {
            const raw = contactInput.value.trim();
            if (!raw) return;
            if (detectType(raw) === 'PHONE') {
                event.preventDefault();
                phoneStatus.textContent = 'Với số điện thoại, hãy dùng nút "Xác thực số điện thoại".';
                phoneVerifyBox.style.display = 'block';
            }
        });

        sendPhoneOtpBtn.addEventListener('click', async () => {
            try {
                const raw = contactInput.value.trim();
                if (!raw) return;
                if (detectType(raw) !== 'PHONE') {
                    phoneStatus.textContent = 'Hãy nhập số điện thoại (không phải email).';
                    return;
                }

                const checked = await checkContact(raw);
                if (!checked.ok) {
                    phoneStatus.textContent = checked.message || 'Dữ liệu không hợp lệ.';
                    return;
                }

                const phone = checked.normalized;
                phoneVerifyBox.style.display = 'block';
                if (!firebase.apps.length) {
                    firebase.initializeApp(firebaseConfig);
                }
                if (!window.recaptchaVerifier) {
                    window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', { size: 'normal' });
                    await window.recaptchaVerifier.render();
                }
                confirmationResult = await firebase.auth().signInWithPhoneNumber(phone, window.recaptchaVerifier);
                phoneStatus.textContent = 'Đã gửi OTP tới số điện thoại.';
            } catch (error) {
                phoneStatus.textContent = error.message || 'Không thể gửi OTP.';
            }
        });

        verifyPhoneOtpBtn.addEventListener('click', async () => {
            try {
                if (!confirmationResult) {
                    phoneStatus.textContent = 'Hãy gửi OTP trước.';
                    return;
                }
                const code = phoneOtpCodeInput.value.trim();
                if (!code) return;
                const result = await confirmationResult.confirm(code);
                const phone = result.user.phoneNumber || contactInput.value.trim();
                const firebaseUid = result.user.uid || null;

                const saveRes = await fetch('/register-step2/phone-verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone, firebaseUid })
                });
                const saveData = await saveRes.json();
                if (!saveRes.ok || !saveData.ok) {
                    phoneStatus.textContent = saveData.message || 'Không thể lưu xác thực.';
                    return;
                }
                window.location.href = saveData.redirectTo || '/verify-otp?type=registration&method=phone';
            } catch (error) {
                phoneStatus.textContent = error.message || 'OTP không hợp lệ.';
            }
        });
    </script>
</body>
</html>
