<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên Mật Khẩu - BusDN VIP PRO</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/auth-custom.css">
</head>
<body class="auth-page">
    <div class="auth-wrapper">
        <div class="glass-form">
            <span class="vip-badge">VIP PRO</span>
            <h1 class="auth-title">Khôi Phục</h1>
            <p class="auth-subtitle">Nhập email để nhận mã xác thực 6 số.</p>

            <% if (error) { %>
                <div class="auth-alert error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="auth-alert success"><%= success %></div>
            <% } %>

            <form action="/forgot-password" method="POST" id="forgotForm">
                <label for="email" class="auth-label">Email</label>
                <div class="input-with-icon">
                    <i class="fa-solid fa-envelope"></i>
                    <input
                        id="email"
                        name="email"
                        class="auth-input"
                        type="email"
                        placeholder="example@busdn.com"
                        value="<%= typeof email !== 'undefined' ? email : '' %>"
                        required
                    >
                </div>

                <button type="submit" id="sendBtn" class="auth-btn">
                    <i class="fa-solid fa-paper-plane"></i> Gửi
                </button>
            </form>

            <p class="muted-line">
                <a href="/login" class="auth-link">Quay lại đăng nhập</a>
            </p>
        </div>
    </div>

    <script>
        const forgotForm = document.getElementById('forgotForm');
        const sendBtn = document.getElementById('sendBtn');

        forgotForm.addEventListener('submit', () => {
            sendBtn.disabled = true;
            sendBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang gửi';
        });
    </script>
</body>
</html>
