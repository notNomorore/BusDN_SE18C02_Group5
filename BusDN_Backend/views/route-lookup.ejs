<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tra Cứu Tuyến Xe - BusDN</title>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        .lookup-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 80px;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 25px;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
        z-index: 2000; /* Cao hơn bản đồ Leaflet */
        border-bottom: 2px solid #ff6b35; /* Tạo điểm nhấn màu cam thương hiệu */
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .lookup-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .logo-bus-icon {
        font-size: 28px;
        background: #003366;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 51, 102, 0.2);
    }

    .logo-bus-text {
        font-size: 22px;
        font-weight: 800;
        color: #003366;
        letter-spacing: -0.5px;
    }

    .header-divider {
        width: 1px;
        height: 30px;
        background: #ddd;
    }

    .page-title {
        color: #666;
        font-size: 14px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .header-right {
        display: flex;
        align-items: center;
    }

    .back-home-link {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #003366;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 20px;
        border-radius: 50px;
        border: 1.5px solid #003366;
        transition: all 0.3s ease;
    }

    .back-home-link:hover {
        background: #003366;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 51, 102, 0.15);
    }

    /* Đảm bảo Container bên dưới không bị che khuất */
    .route-lookup-container {
        margin-top: 80px !important;
    }

    /* Responsive cho mobile */
    @media (max-width: 768px) {
        .page-title, .header-divider {
            display: none;
        }
        .lookup-header {
            padding: 0 15px;
        }
        .back-home-link span {
            display: none;
        }
        .back-home-link {
            padding: 10px;
            border-radius: 50%;
        }
    }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
        }

        /* Main Layout */
        .route-lookup-container {
            display: flex;
            height: calc(100vh - 80px);
            background: white;
            margin-top: 80px;
        }

        /* Sidebar (35%) */
        .sidebar {
            width: 35%;
            background: linear-gradient(135deg, #003366 0%, #004080 100%);
            color: white;
            padding: 25px;
            overflow-y: auto;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .sidebar h2 {
            font-size: 24px;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .sidebar p {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 25px;
        }

        /* Search Section */
        .search-section {
            background: rgba(255, 255, 255, 0.1);
            padding: 18px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .search-section label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0.95;
        }

        .search-section input,
        .search-section select {
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            margin-bottom: 10px;
            background: white;
            color: #333;
            transition: box-shadow 0.3s;
        }

        .search-section input:focus,
        .search-section select:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);
        }

        .search-btn {
            width: 100%;
            padding: 11px;
            background: #ff6b35;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .search-btn:hover {
            background: #ff5722;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
        }

        /* Results Section */
        .results-section {
            margin-top: 20px;
        }

        .results-section h3 {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0.95;
        }

        .route-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 14px;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.3s;
            border-left: 4px solid #ff6b35;
        }

        .route-item:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(5px);
        }

        .route-item.active {
            background: white;
            color: #003366;
        }

        .route-item.active .route-number {
            color: #ff6b35;
        }

        .route-number {
            font-size: 17px;
            font-weight: 700;
            color: #ff6b35;
        }

        .route-name {
            font-size: 12px;
            opacity: 0.85;
            margin-top: 4px;
            color: white;
        }

        .route-item.active .route-name {
            color: #666;
        }

        .no-results {
            text-align: center;
            padding: 25px 15px;
            opacity: 0.7;
            font-size: 13px;
        }

        .loading {
            text-align: center;
            padding: 20px;
            opacity: 0.8;
        }

        /* Map Section (65%) */
        .map-section {
            width: 65%;
            position: relative;
        }

        #map {
            width: 100%;
            height: 100%;
            z-index: 10;
        }

        /* ============ DIRECTION & TABS SECTION ============ */
        .detail-panel {
            position: absolute;
            top: 20px;
            left: 20px;
            width: 320px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            z-index: 1001;
            overflow: hidden;
            display: none;
        }

        .detail-header {
            background: linear-gradient(135deg, #003366 0%, #004080 100%);
            color: white;
            padding: 15px;
            border-bottom: 3px solid #ff6b35;
        }

        .detail-header h3 {
            font-size: 16px;
            margin: 0 0 4px 0;
            font-weight: 700;
        }

        .detail-header p {
            font-size: 12px;
            margin: 0;
            opacity: 0.9;
        }

        /* Direction Toggle Buttons */
        .direction-toggle {
            display: flex;
            gap: 10px;
            padding: 15px;
            background: #f9f9f9;
            border-bottom: 1px solid #eee;
        }

        .direction-btn {
            flex: 1;
            padding: 10px;
            border: 2px solid #ddd;
            background: white;
            color: #333;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .direction-btn.active {
            background: #003366;
            color: white;
            border-color: #003366;
        }

        .direction-btn:hover:not(.active) {
            border-color: #003366;
        }

        /* Tabs */
        .tabs-container {
            padding: 15px;
        }

        .tabs-header {
            display: flex;
            gap: 8px;
            border-bottom: 2px solid #eee;
            margin-bottom: 15px;
        }

        .tab-btn {
            flex: 1;
            padding: 10px 8px;
            background: none;
            border: none;
            color: #666;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border-bottom: 3px solid transparent;
            position: relative;
            bottom: -2px;
        }

        .tab-btn.active {
            color: #003366;
            border-bottom-color: #ff6b35;
        }

        .tab-content {
            display: none;
            max-height: 250px;
            overflow-y: auto;
            font-size: 13px;
            color: #333;
        }

        .tab-content.active {
            display: block;
        }

        /* Stops Tab */
        .stop-item {
            padding: 10px;
            margin-bottom: 8px;
            background: #f5f5f5;
            border-radius: 6px;
            border-left: 3px solid #ff6b35;
            display: flex;
            gap: 10px;
        }

        .stop-order {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ff6b35;
            color: white;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            font-weight: 700;
            font-size: 12px;
            flex-shrink: 0;
        }

        .stop-info {
            flex: 1;
        }

        .stop-name {
            font-weight: 600;
            color: #003366;
            display: block;
            margin-bottom: 2px;
        }

        .stop-time {
            font-size: 11px;
            color: #999;
        }

        /* Info Tab */
        .info-item {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-label {
            font-weight: 600;
            color: #003366;
            font-size: 12px;
            display: block;
            margin-bottom: 3px;
        }

        .info-value {
            color: #666;
            font-size: 13px;
        }

        /* Reviews Tab */
        .review-item {
            padding: 12px;
            margin-bottom: 10px;
            background: #f5f5f5;
            border-radius: 6px;
            border-left: 3px solid #ff6b35;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }

        .review-author {
            font-weight: 600;
            color: #003366;
        }

        .review-rating {
            color: #ff6b35;
            font-weight: 600;
        }

        .review-text {
            font-size: 12px;
            color: #666;
            line-height: 1.4;
        }

        .empty-reviews {
            text-align: center;
            padding: 20px;
            color: #999;
            font-style: italic;
        }

        /* Info Panel for quick info */
        .info-panel {
            position: absolute;
            bottom: 20px;
            left: 20px;
            background: white;
            padding: 12px 16px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
            z-index: 1000;
            font-size: 12px;
            display: none;
        }

        .info-panel p {
            margin: 3px 0;
            color: #333;
        }

        .info-panel strong {
            color: #003366;
        }

        /* Mobile CTA Modal */
        .cta-modal {
            position: absolute;
            top: 20px;
            right: 20px;
            background: white;
            padding: 18px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            max-width: 280px;
            z-index: 1001;
        }

        .cta-modal h3 {
            color: #003366;
            font-size: 15px;
            margin-bottom: 10px;
        }

        .cta-modal p {
            font-size: 12px;
            color: #666;
            margin-bottom: 12px;
            line-height: 1.4;
        }

        .cta-buttons {
            display: flex;
            gap: 8px;
        }

        .cta-buttons a {
            flex: 1;
            padding: 8px;
            border-radius: 6px;
            text-align: center;
            font-size: 11px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s;
        }

        .cta-buttons .ios {
            background: #003366;
            color: white;
        }

        .cta-buttons .ios:hover {
            background: #004080;
        }

        .cta-buttons .android {
            background: #ff6b35;
            color: white;
        }

        .cta-buttons .android:hover {
            background: #ff5722;
        }

        .close-cta {
            position: absolute;
            top: 8px;
            right: 8px;
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #999;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .route-lookup-container {
                flex-direction: column;
                height: auto;
            }

            .sidebar {
                width: 100%;
                height: auto;
                max-height: 280px;
            }

            .map-section {
                width: 100%;
                height: 500px;
            }

            .detail-panel {
                width: 90%;
                left: 5%;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                padding: 15px;
            }

            .sidebar h2 {
                font-size: 20px;
            }

            .cta-modal {
                display: none !important;
            }

            .detail-panel {
                width: 280px;
                font-size: 11px;
            }

            .detail-panel h3 {
                font-size: 14px;
            }
        }
    </style>
</head>

<body>
    <header class="lookup-header">
        <div class="header-left">
            <a href="/" class="lookup-logo">
                <span class="logo-bus-icon">🚌</span>
                <span class="logo-bus-text">BusDN</span>
            </a>
            <div class="header-divider"></div>
            <span class="page-title">Tra cứu lộ trình</span>
        </div>

        <div class="header-right">
            <a href="/" class="back-home-link">
                <i class="fa-solid fa-house"></i>
                <span>Về trang chủ</span>
            </a>
        </div>
    </header>
    <div class="route-lookup-container">
        <!-- Sidebar: Search Panel -->
        <div class="sidebar">
            <h2>🚌 Tra Cứu Tuyến</h2>
            <p>Tìm tuyến xe và xem lộ trình trên bản đồ</p>

            <div class="search-section">
                <label for="searchInput">Tìm kiếm tuyến xe</label>
                <input type="text" id="searchInput" placeholder="Nhập số tuyến (VD: 01, 02) hoặc tên..."
                    autocomplete="off">
                <button class="search-btn" onclick="searchRoutes()">🔍 Tìm Kiếm</button>
            </div>

            <div class="results-section">
                <h3>Danh sách tuyến</h3>
                <div id="routesList">
                    <p class="no-results">Nhập từ khóa để tìm kiếm</p>
                </div>
            </div>
        </div>

        <!-- Map Section -->
        <div class="map-section">
            <div id="map"></div>

            <!-- Detail Panel with Direction Toggle and Tabs -->
            <div class="detail-panel" id="detailPanel">
                <div class="detail-header">
                    <h3 id="detailRouteName">Tuyến ---</h3>
                    <p id="detailRouteNumber">Số hiệu: ---</p>
                </div>

                <!-- Direction Toggle -->
                <div class="direction-toggle">
                    <button class="direction-btn active" id="outboundBtn" onclick="switchDirection('OUTBOUND')">
                        📍 Lượt đi
                    </button>
                    <button class="direction-btn" id="inboundBtn" onclick="switchDirection('INBOUND')">
                        🔙 Lượt về
                    </button>
                </div>

                <!-- Tabs -->
                <div class="tabs-container">
                    <div class="tabs-header">
                        <button class="tab-btn active" onclick="switchTab('stops')">Trạm dừng</button>
                        <button class="tab-btn" onclick="switchTab('info')">Thông tin</button>
                        <button class="tab-btn" onclick="switchTab('reviews')">Đánh giá</button>
                    </div>

                    <!-- Stops Tab -->
                    <div class="tab-content active" id="stops-tab">
                        <div id="stopsList"></div>
                    </div>

                    <!-- Info Tab -->
                    <div class="tab-content" id="info-tab">
                        <div class="info-item">
                            <span class="info-label">Số hiệu tuyến:</span>
                            <span class="info-value" id="infoRouteNumber2">---</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Khoảng cách:</span>
                            <span class="info-value" id="infoDistance">---</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Thời gian hoạt động:</span>
                            <span class="info-value" id="infoOpTime">---</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Vé lượt ước tính:</span>
                            <span class="info-value" id="infoSingleRideFare">---</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Vé tháng hiệu lực:</span>
                            <span class="info-value" id="infoMonthlyFare">---</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Hướng đi:</span>
                            <span class="info-value" id="infoDirection">---</span>
                        </div>
                    </div>

                    <!-- Reviews Tab -->
                    <div class="tab-content" id="reviews-tab">
                        <div id="reviewsList" class="empty-reviews">
                            Chưa có đánh giá. Hãy là người đầu tiên!
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Info Panel -->
            <div class="info-panel" id="infoPanel">
                <p><strong>Tuyến:</strong> <span id="infoRouteName"></span></p>
                <p><strong>Khoảng cách:</strong> <span id="infoDistanceQuick"></span> km</p>
            </div>

            <!-- Mobile CTA Modal -->
            <div class="cta-modal">
                <button class="close-cta" onclick="closeCTA()">✕</button>
                <h3>📱 Muốn Đặt Vé?</h3>
                <p>Tải ứng dụng BusDN để đặt vé, thanh toán dễ dàng!</p>
                <div class="cta-buttons">
                    <a href="#" class="ios">🍎 App Store</a>
                    <a href="#" class="android">▶ CHPlay</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // ============ GLOBAL STATE ============
        var map = L.map('map').setView([16.047079, 108.206230], 13);
        let routeMarkers = [];
        let currentRoute = null;
        let currentDirection = 'OUTBOUND';

        // ============ MAP INITIALIZATION ============
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // ============ EVENT LISTENERS ============
        document.getElementById('searchInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') searchRoutes();
        });

        window.onload = function () {
            searchRoutes(true);
        };

        // ============ SEARCH FUNCTION ============
        function searchRoutes(isInitial = false) {
            const searchValue = document.getElementById('searchInput').value.trim();
            const listContainer = document.getElementById('routesList');

            if (!isInitial && !searchValue) {
                listContainer.innerHTML = '<p class="no-results">Vui lòng nhập từ khóa tìm kiếm</p>';
                return;
            }

            listContainer.innerHTML = '<p class="loading">⏳ Đang tải dữ liệu...</p>';

            fetch(`/api/public/routes?search=${encodeURIComponent(searchValue)}`)
                .then(res => res.json())
                .then(data => {
                    let routes = [];
                    if (data.data && data.data.routes) {
                        routes = data.data.routes;
                    } else if (data.data && Array.isArray(data.data)) {
                        routes = data.data;
                    } else if (Array.isArray(data)) {
                        routes = data;
                    }

                    if (!routes || routes.length === 0) {
                        listContainer.innerHTML = '<p class="no-results">❌ Không tìm thấy tuyến xe</p>';
                        return;
                    }

                    let html = '';
                    routes.forEach(route => {
                        const singleFare = Number(route?.fareInfo?.singleRideEstimatedFare || 0);
                        html += `
                            <div class="route-item" onclick="selectRoute('${route._id}')">
                                <div class="route-number">${route.routeNumber}</div>
                                <div class="route-name">${route.name} · Vé lượt ~ ${singleFare.toLocaleString('vi-VN')} đ</div>
                            </div>
                        `;
                    });
                    listContainer.innerHTML = html;
                })
                .catch(error => {
                    console.error('Error:', error);
                    listContainer.innerHTML = '<p class="no-results">❌ Lỗi kết nối</p>';
                });
        }

        // ============ SELECT ROUTE ============
        function selectRoute(routeId) {
            document.querySelectorAll('.route-item').forEach(el => el.classList.remove('active'));
            if (event && event.currentTarget) {
                event.currentTarget.classList.add('active');
            }

            fetch(`/api/public/routes/${routeId}`)
                .then(res => res.json())
                .then(resData => {
                    currentRoute = resData.data || resData;
                    currentDirection = 'OUTBOUND';

                    clearMapMarkers();
                    displayDetailPanel();
                    displayRouteOnMap(currentRoute, 'OUTBOUND');
                    updateTabs('OUTBOUND');
                })
                .catch(err => alert('❌ Không thể tải chi tiết tuyến'));
        }

        // ============ DISPLAY DETAIL PANEL ============
        function displayDetailPanel() {
            if (!currentRoute) return;

            document.getElementById('detailRouteName').textContent = `Tuyến ${currentRoute.routeNumber}`;
            document.getElementById('detailRouteNumber').textContent = currentRoute.name;
            document.getElementById('infoRouteNumber2').textContent = currentRoute.routeNumber;
            document.getElementById('infoDistance').textContent = currentRoute.distance || '---';
            document.getElementById('infoOpTime').textContent =
                `${currentRoute.operationTime.start} - ${currentRoute.operationTime.end}`;
            document.getElementById('infoSingleRideFare').textContent =
                `${Number(currentRoute?.fareInfo?.singleRideEstimatedFare || 0).toLocaleString('vi-VN')} đ`;
            document.getElementById('infoMonthlyFare').textContent =
                `${Number(currentRoute?.fareInfo?.monthlyPassEffectivePrice || 0).toLocaleString('vi-VN')} đ`;
            document.getElementById('infoRouteName').textContent = currentRoute.name;
            document.getElementById('infoDistanceQuick').textContent = currentRoute.distance || '---';

            document.getElementById('detailPanel').style.display = 'block';
            document.getElementById('infoPanel').style.display = 'block';
        }

        // ============ DIRECTION TOGGLE ============
        function switchDirection(direction) {
            currentDirection = direction;

            document.getElementById('outboundBtn').classList.toggle('active', direction === 'OUTBOUND');
            document.getElementById('inboundBtn').classList.toggle('active', direction === 'INBOUND');

            clearMapMarkers();
            displayRouteOnMap(currentRoute, direction);
            updateTabs(direction);
        }

        // ============ TAB SWITCHING ============
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));

            event.currentTarget.classList.add('active');
            document.getElementById(`${tabName}-tab`).classList.add('active');
        }

        // ============ UPDATE TABS CONTENT ============
        function updateTabs(direction) {
            if (!currentRoute) return;

            const directionStops = getStopsByDirection(currentRoute, direction);
            displayStopsTab(directionStops);

            const dirVN = direction === 'OUTBOUND' ? 'Lượt đi' : 'Lượt về';
            document.getElementById('infoDirection').textContent = dirVN;
        }

        // ============ GET STOPS BY DIRECTION ============
        function getStopsByDirection(route, direction) {
            if (!route.stops) return [];

            if (Array.isArray(route.stops)) {
                return route.stops.filter(s => s.direction === direction)
                    .sort((a, b) => a.orderIndex - b.orderIndex);
            }

            if (route.stops[direction.toLowerCase()]) {
                return route.stops[direction.toLowerCase()];
            }

            return [];
        }

        // ============ DISPLAY STOPS TAB ============
        function displayStopsTab(stops) {
            let html = '';
            if (stops.length === 0) {
                html = '<p class="empty-reviews">Không có dữ liệu trạm dừng</p>';
            } else {
                stops.forEach((stop, idx) => {
                    html += `
                        <div class="stop-item">
                            <span class="stop-order">${idx + 1}</span>
                            <div class="stop-info">
                                <span class="stop-name">${stop.stopId.name}</span>
                                <span class="stop-time">${stop.estimatedArrivalTime || '---'}</span>
                            </div>
                        </div>
                    `;
                });
            }
            document.getElementById('stopsList').innerHTML = html;
        }

        // ============ DISPLAY ROUTE ON MAP ============
        function displayRouteOnMap(route, direction) {
            const stops = getStopsByDirection(route, direction);
            if (stops.length === 0) return;

            const coordsForOSRM = [];

            // Draw markers for each stop
            stops.forEach((stop, index) => {
                const point = stop.stopId;
                if (!point) return;

                // Extract coordinates from GeoJSON format: [lng, lat]
                let lat, lng;
                if (point.location && point.location.coordinates) {
                    lng = point.location.coordinates[0];
                    lat = point.location.coordinates[1];
                } else if (point.lat && point.lng) {
                    lat = point.lat;
                    lng = point.lng;
                } else {
                    return;
                }

                // Choose marker color
                const markerColor = index === 0 ? '#28a745' :
                    (index === stops.length - 1 ? '#dc3545' : '#003366');

                const marker = L.circleMarker([lat, lng], {
                    radius: 8,
                    fillColor: markerColor,
                    color: "#fff",
                    weight: 2.5,
                    fillOpacity: 1
                }).bindPopup(`<b>${stop.stopId.name}</b><br>Trạm ${index + 1}`);

                marker.addTo(map);
                routeMarkers.push(marker);
                coordsForOSRM.push(`${lng},${lat}`);
            });

            // Call OSRM for street-level routing
            if (coordsForOSRM.length >= 2) {
                const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${coordsForOSRM.join(';')}?overview=full&geometries=geojson`;

                fetch(osrmUrl)
                    .then(res => res.json())
                    .then(data => {
                        if (data.routes && data.routes[0]) {
                            const routeLine = L.geoJSON(data.routes[0].geometry, {
                                style: { color: '#003366', weight: 5, opacity: 0.7 }
                            }).addTo(map);
                            routeMarkers.push(routeLine);

                            // Fit map to route bounds
                            map.fitBounds(routeLine.getBounds(), { padding: [100, 100] });
                        }
                    })
                    .catch(err => console.error('OSRM Error:', err));
            }
        }

        // ============ UTILITY FUNCTIONS ============
        function clearMapMarkers() {
            routeMarkers.forEach(m => {
                if (m instanceof L.GeoJSON || m instanceof L.Polyline) {
                    map.removeLayer(m);
                } else if (m instanceof L.CircleMarker) {
                    map.removeLayer(m);
                }
            });
            routeMarkers = [];
        }

        function closeCTA() {
            document.querySelector('.cta-modal').style.display = 'none';
        }
    </script>
</body>

</html>
