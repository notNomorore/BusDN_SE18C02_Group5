<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt Lại Mật Khẩu - BusDN VIP PRO</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/auth-custom.css">
</head>
<body class="auth-page">
    <div class="auth-wrapper">
        <div class="glass-form">
            <span class="vip-badge">VIP PRO</span>
            <h1 class="auth-title">Mật Khẩu Mới</h1>
            <p class="auth-subtitle">Thiết lập mật khẩu mới cho tài khoản của bạn.</p>

            <% if (error) { %>
                <div class="auth-alert error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="auth-alert success"><%= success %></div>
            <% } %>

            <form action="/reset-password" method="POST" id="resetForm">
                <input type="hidden" name="token" value="<%= token %>">
                <input type="hidden" name="email" value="<%= email %>">

                <label for="newPassword" class="auth-label">Mật khẩu mới</label>
                <div class="input-with-icon">
                    <i class="fa-solid fa-lock"></i>
                    <input
                        id="newPassword"
                        name="newPassword"
                        class="auth-input"
                        type="password"
                        placeholder="Nhập mật khẩu mới"
                        required
                    >
                </div>

                <label for="confirmPassword" class="auth-label">Xác nhận mật khẩu</label>
                <div class="input-with-icon">
                    <i class="fa-solid fa-lock"></i>
                    <input
                        id="confirmPassword"
                        name="confirmPassword"
                        class="auth-input"
                        type="password"
                        placeholder="Nhập lại mật khẩu mới"
                        required
                    >
                </div>

                <div class="rules">
                    <strong>Yêu cầu mật khẩu:</strong>
                    <div class="rule-item" id="rule-length">Ít nhất 8 ký tự</div>
                    <div class="rule-item" id="rule-upper">Có chữ in hoa</div>
                    <div class="rule-item" id="rule-lower">Có chữ thường</div>
                    <div class="rule-item" id="rule-number">Có chữ số</div>
                    <div class="rule-item" id="rule-special">Có ký tự đặc biệt (@$!%*?&)</div>
                    <div class="rule-item" id="rule-match">Hai mật khẩu khớp nhau</div>
                </div>

                <button type="submit" class="auth-btn" id="submitBtn" disabled>Đặt Lại Mật Khẩu</button>
            </form>
        </div>
    </div>

    <script>
        const newPasswordInput = document.getElementById('newPassword');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const submitBtn = document.getElementById('submitBtn');

        const rules = {
            length: document.getElementById('rule-length'),
            upper: document.getElementById('rule-upper'),
            lower: document.getElementById('rule-lower'),
            number: document.getElementById('rule-number'),
            special: document.getElementById('rule-special'),
            match: document.getElementById('rule-match')
        };

        function validate() {
            const p1 = newPasswordInput.value;
            const p2 = confirmPasswordInput.value;

            const checks = {
                length: p1.length >= 8,
                upper: /[A-Z]/.test(p1),
                lower: /[a-z]/.test(p1),
                number: /\d/.test(p1),
                special: /[@$!%*?&]/.test(p1),
                match: p1.length > 0 && p1 === p2
            };

            Object.keys(checks).forEach((key) => {
                if (checks[key]) {
                    rules[key].classList.add('valid');
                } else {
                    rules[key].classList.remove('valid');
                }
            });

            submitBtn.disabled = !Object.values(checks).every(Boolean);
        }

        newPasswordInput.addEventListener('input', validate);
        confirmPasswordInput.addEventListener('input', validate);

        document.getElementById('resetForm').addEventListener('submit', () => {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý';
        });
    </script>
</body>
</html>
