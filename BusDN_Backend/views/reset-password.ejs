<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt lại mật khẩu | BusDN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    
    <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
        <h4 class="text-center mb-3">🔐 Đặt lại mật khẩu</h4>
        <p class="text-muted text-center small">Nhập mật khẩu mới để khôi phục tài khoản của bạn.</p>
        
        <% if(error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        
        <form action="/reset-password/<%= userId %>" method="POST">
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu mới" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu</label>
                <input type="password" name="confirmPassword" class="form-control" placeholder="Xác nhận mật khẩu" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Đặt lại mật khẩu</button>
        </form>
        
        <div class="text-center mt-3">
            <a href="/login" class="text-decoration-none">Quay lại Đăng nhập</a>
        </div>
    </div>

</body>
</html>
