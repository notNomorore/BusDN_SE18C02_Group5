<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - BusDN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(140deg, #dbeafe 0%, #e0f2fe 45%, #eff6ff 100%);
        }

        .profile-shell {
            max-width: 980px;
            margin: 30px auto;
        }

        .profile-card {
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid #dbe7ff;
            border-radius: 18px;
            box-shadow: 0 15px 30px rgba(26, 69, 145, 0.12);
            padding: 22px;
        }

        .section-card {
            border: 1px solid #e6edf8;
            border-radius: 14px;
            padding: 16px;
            background: #fff;
            height: 100%;
        }

        .avatar {
            width: 108px;
            height: 108px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <div class="container">
        <div class="profile-shell">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>

            <div class="profile-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <img src="<%= user.avatar || '/images/default-avatar.png' %>" class="avatar" alt="avatar">
                    <div>
                        <h3 class="mb-1"><%= user.fullName || 'Passenger' %></h3>
                        <div class="text-muted"><%= user.email || 'No email' %></div>
                        <div class="mt-1">
                            <span class="badge <%= user.isVerified ? 'bg-success' : 'bg-warning text-dark' %>">
                                <%= user.isVerified ? 'Verified' : 'Unverified' %>
                            </span>
                            <span class="badge bg-primary"><%= user.role || 'PASSENGER' %></span>
                        </div>
                    </div>
                    <form action="/upload-avatar" method="POST" enctype="multipart/form-data" class="ms-auto">
                        <label class="btn btn-outline-primary btn-sm mb-0">
                            <i class="fa-solid fa-camera me-1"></i> Change avatar
                            <input type="file" name="avatar" class="d-none" onchange="this.form.submit()">
                        </label>
                    </form>
                </div>

                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="section-card">
                            <h5 class="mb-3"><i class="fa-solid fa-user-pen me-2 text-primary"></i>User Info</h5>
                            <form action="/edit-profile" method="POST">
                                <div class="mb-3">
                                    <label class="form-label">Full name</label>
                                    <input type="text" name="fullName" class="form-control" value="<%= user.fullName || '' %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Phone</label>
                                    <input type="text" name="phone" class="form-control" value="<%= user.phone || '' %>" placeholder="Enter phone number">
                                </div>
                                <button class="btn btn-primary w-100" type="submit">Save Profile</button>
                            </form>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="section-card">
                            <h5 class="mb-3"><i class="fa-solid fa-id-card me-2 text-info"></i>Priority Status</h5>
                            <div class="mb-2"><strong>Status:</strong> <span class="badge bg-secondary"><%= user.priorityStatus || 'NONE' %></span></div>
                            <div class="mb-2"><strong>Active group:</strong> <%= user.isPriorityGroup ? 'Yes' : 'No' %></div>
                            <div class="mb-3">
                                <strong>Expiry:</strong>
                                <%= user.priorityProfile && user.priorityProfile.expiryDate ? new Date(user.priorityProfile.expiryDate).toLocaleDateString('vi-VN') : 'N/A' %>
                            </div>
                            <div class="d-grid gap-2">
                                <a href="/priority/status" class="btn btn-outline-primary btn-sm">View Priority Status</a>
                                <a href="/priority/register" class="btn btn-outline-success btn-sm">Submit/Resubmit Profile</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="section-card">
                            <h5 class="mb-3"><i class="fa-solid fa-shield-halved me-2 text-danger"></i>Change Password</h5>
                            <form action="/change-password" method="POST">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Current Password</label>
                                        <input type="password" name="oldPassword" class="form-control" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">New Password</label>
                                        <input type="password" name="newPassword" class="form-control" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Confirm New Password</label>
                                        <input type="password" name="confirmPassword" class="form-control" required>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-danger" type="submit">Update Password</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
