<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Hồ sơ cá nhân</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="container mt-5">
        <div class="card mx-auto shadow" style="max-width: 500px;">
            <div class="card-header bg-primary text-white text-center">
                <h4>HỒ SƠ HÀNH KHÁCH</h4>
            </div>
            <div class="card-body text-center">
                <img src="<%= user.avatar %>" class="rounded-circle border mb-3"
                    style="width: 150px; height: 150px; object-fit: cover;">

                <form action="/upload-avatar" method="POST" enctype="multipart/form-data" class="mb-4">
                    <div class="input-group">
                        <input type="file" name="avatar" class="form-control" required>
                        <button class="btn btn-outline-primary" type="submit">Đổi Ảnh</button>
                    </div>
                </form>

                <form action="/edit-profile" method="POST">
                    <div class="mb-3 text-start">
                        <label class="fw-bold">Email:</label>
                        <input type="text" class="form-control" value="<%= user.email %>" disabled>
                        <small class="text-success">✔ Đã xác thực email</small>
                    </div>
                    <div class="mb-3 text-start">
                        <label class="fw-bold">Họ và tên:</label>
                        <input type="text" name="fullName" class="form-control" value="<%= user.fullName %>">
                    </div>
                    <button type="submit" class="btn btn-warning w-100 mb-2">Lưu thông tin & Về trang chủ</button>
                </form>
                <hr>
                <div class="text-center mb-3">
                    <a href="/home" class="text-decoration-none me-3"><i class="fas fa-arrow-left"></i> Quay lại trang chủ</a>
                    <a href="/change-password" class="text-decoration-none text-warning"><i class="fas fa-key"></i> Đổi mật khẩu</a>
                </div>
                <a href="/logout" class="btn btn-dark w-100 mt-2">Đăng xuất</a>
            </div>
        </div>
    </div>
</body>

</html>