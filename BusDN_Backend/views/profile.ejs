<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hồ sơ cá nhân - BusDN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .nav-link.active {
            background-color: #003366 !important;
            color: white !important;
            border-radius: 8px;
        }

        .verified-badge {
            color: #198754;
            font-size: 0.9rem;
            margin-left: 5px;
        }

        .unverified-badge {
            color: #dc3545;
            font-size: 0.9rem;
            margin-left: 5px;
            cursor: pointer;
        }

        /* Style cho nút con mắt hiện mật khẩu */
        .password-toggle {
            cursor: pointer;
            color: #6c757d;
            z-index: 10;
        }

        .password-toggle:hover {
            color: #003366;
        }

        input::-ms-reveal,
        input::-ms-clear {
            display: none;
        }

        /* 2. Chỉnh lại vị trí con mắt của mình cho đẹp hơn */
        .password-toggle {
            cursor: pointer;
            color: #6c757d;
            z-index: 10;
            /* Đảm bảo nó nằm gọn bên phải */
            right: 15px !important;
        }

        /* 3. Thêm padding cho ô input để chữ không bị dính vào con mắt */
        input[type="password"],
        input[type="text"] {
            padding-right: 40px;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="container my-5">

            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert alert-danger text-center">
                    <%= error %>
                </div>
                <% } %>
                    <% if (typeof success !=='undefined' && success) { %>
                        <div class="alert alert-success text-center">
                            <%= success %>
                        </div>
                        <% } %>

                            <div class="row">
                                <div class="col-lg-4 mb-4">
                                    <div class="card border-0 shadow-sm text-center p-4 h-100"
                                        style="background: linear-gradient(180deg, #ffffff 0%, #eef2f7 100%);">
                                        <div class="position-relative d-inline-block mb-3">
                                            <img src="<%= user.avatar || 'https://via.placeholder.com/150' %>"
                                                class="rounded-circle border border-4 border-white shadow" width="120"
                                                height="120" style="object-fit: cover;">
                                            <form action="/upload-avatar" method="POST" enctype="multipart/form-data"
                                                id="avatarForm">
                                                <label for="avatarInput"
                                                    class="position-absolute bottom-0 end-0 bg-warning text-dark rounded-circle p-2 shadow-sm"
                                                    style="cursor: pointer; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                                    <i class="fa-solid fa-camera"></i>
                                                </label>
                                                <input type="file" name="avatar" id="avatarInput" class="d-none"
                                                    onchange="document.getElementById('avatarForm').submit()">
                                            </form>
                                        </div>
                                        <h5 class="fw-bold mb-1">
                                            <%= user.fullName %>
                                        </h5>
                                        <p class="text-muted small mb-3">
                                            <%= user.role || 'Hành khách' %>
                                        </p>

                                        <div class="card bg-primary text-white p-3 mb-3 text-start shadow-sm"
                                            style="background: #003366 !important;">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <small class="opacity-75">Số dư ví BusDN</small>
                                                    <h4 class="fw-bold mb-0">250.000 đ</h4>
                                                </div>
                                                <i class="fa-solid fa-wallet fa-2x opacity-50"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-8">
                                    <div class="card border-0 shadow-sm p-4 h-100">
                                        <ul class="nav nav-pills mb-4 nav-justified" id="pills-tab" role="tablist">
                                            <li class="nav-item p-1">
                                                <button class="nav-link active fw-bold" id="info-tab"
                                                    data-bs-toggle="pill" data-bs-target="#pills-info">
                                                    <i class="fa-solid fa-user-pen me-2"></i> Thông tin
                                                </button>
                                            </li>
                                            <li class="nav-item p-1">
                                                <button class="nav-link fw-bold text-dark" id="ticket-tab"
                                                    data-bs-toggle="pill" data-bs-target="#pills-ticket">
                                                    <i class="fa-solid fa-ticket me-2"></i> Vé của tôi
                                                </button>
                                            </li>
                                            <li class="nav-item p-1">
                                                <button class="nav-link fw-bold text-dark" id="security-tab"
                                                    data-bs-toggle="pill" data-bs-target="#pills-security">
                                                    <i class="fa-solid fa-shield-halved me-2"></i> Bảo mật
                                                </button>
                                            </li>
                                        </ul>

                                        <div class="tab-content" id="pills-tabContent">

                                            <div class="tab-pane fade show active" id="pills-info">
                                                <form action="/edit-profile" method="POST">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold text-secondary">Họ và
                                                            tên</label>
                                                        <input type="text" name="fullName"
                                                            class="form-control form-control-lg"
                                                            value="<%= user.fullName %>">
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-6 mb-3">
                                                            <label
                                                                class="form-label fw-bold text-secondary">Email</label>
                                                            <div class="input-group">
                                                                <input type="text" class="form-control bg-light"
                                                                    value="<%= user.email %>" readonly>
                                                                <span class="input-group-text bg-white text-success"><i
                                                                        class="fa-solid fa-circle-check"></i></span>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 mb-3">
                                                            <label class="form-label fw-bold text-secondary">
                                                                Số điện thoại
                                                                <% if (user.phone) { %>
                                                                    <span class="verified-badge"><i
                                                                            class="fa-solid fa-circle-check"></i> Đã xác
                                                                        thực</span>
                                                                    <% } else { %>
                                                                        <span class="unverified-badge"><i
                                                                                class="fa-solid fa-circle-exclamation"></i>
                                                                            Chưa xác thực</span>
                                                                        <% } %>
                                                            </label>
                                                            <input type="text" name="phone" class="form-control"
                                                                value="<%= user.phone || '' %>"
                                                                placeholder="Nhập SĐT...">
                                                        </div>
                                                    </div>
                                                    <hr class="text-muted my-4">
                                                    <button type="submit"
                                                        class="btn btn-warning fw-bold px-4 py-2 w-100">Lưu thay
                                                        đổi</button>
                                                </form>
                                            </div>

                                            <div class="tab-pane fade" id="pills-ticket">
                                                <div class="text-center py-5 text-muted">
                                                    <i class="fa-solid fa-ticket fa-3x mb-3 opacity-50"></i>
                                                    <p>Bạn chưa có vé nào. <a href="#"
                                                            class="text-decoration-none fw-bold">Mua vé ngay</a></p>
                                                </div>
                                            </div>

                                            <div class="tab-pane fade" id="pills-security">
                                                <form action="/change-password" method="POST">
                                                    <div class="mb-3 position-relative">
                                                        <label class="form-label fw-bold text-secondary">Mật khẩu hiện
                                                            tại</label>
                                                        <input type="password" name="oldPassword" id="oldPass"
                                                            class="form-control" required>
                                                        <i class="fa-regular fa-eye password-toggle position-absolute top-50 end-0 translate-middle-y me-3 pt-4"
                                                            onclick="togglePass('oldPass')"></i>
                                                    </div>

                                                    <div class="mb-3 position-relative">
                                                        <label class="form-label fw-bold text-secondary">Mật khẩu
                                                            mới</label>
                                                        <input type="password" name="newPassword" id="newPass"
                                                            class="form-control" required>
                                                        <i class="fa-regular fa-eye password-toggle position-absolute top-50 end-0 translate-middle-y me-3 pt-4"
                                                            onclick="togglePass('newPass')"></i>
                                                    </div>

                                                    <div class="mb-4 position-relative">
                                                        <label class="form-label fw-bold text-secondary">Xác nhận mật
                                                            khẩu mới</label>
                                                        <input type="password" name="confirmPassword" id="confirmPass"
                                                            class="form-control" required>
                                                        <i class="fa-regular fa-eye password-toggle position-absolute top-50 end-0 translate-middle-y me-3 pt-4"
                                                            onclick="togglePass('confirmPass')"></i>
                                                    </div>

                                                    <button type="submit"
                                                        class="btn btn-danger fw-bold px-4 py-2 w-100">
                                                        <i class="fa-solid fa-key me-2"></i> Xác nhận đổi mật khẩu
                                                    </button>
                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            function togglePass(inputId) {
                const input = document.getElementById(inputId);
                const icon = input.nextElementSibling;
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            }
        </script>
</body>

</html>