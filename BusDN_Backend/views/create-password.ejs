<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - Bước 4</title>
    <style>
        body { margin:0; min-height:100vh; display:grid; place-items:center; font-family:Segoe UI,sans-serif; background:linear-gradient(140deg,#dbeafe,#e0f2fe,#eff6ff); }
        .card { width:min(560px,94vw); padding:26px; border-radius:18px; background:rgba(255,255,255,.9); border:1px solid #dbe7ff; box-shadow:0 14px 28px rgba(30,64,175,.15); }
        .title { margin:0 0 6px; color:#1d4ed8; }
        .sub { margin:0 0 16px; color:#475569; }
        input { width:100%; padding:12px; border-radius:10px; border:1px solid #cbd5e1; margin:8px 0 12px; }
        .btn { border:none; border-radius:10px; padding:11px 14px; font-weight:700; color:#fff; background:#2563eb; cursor:pointer; }
        .btn.secondary { background:#64748b; text-decoration:none; display:inline-block; }
        .row { display:flex; gap:10px; flex-wrap:wrap; }
        .alert { background:#fee2e2; color:#b91c1c; padding:10px; border-radius:10px; margin-bottom:10px; }
        .password-rules { display:none; background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:10px; margin-top:8px; font-size:13px; color:#334155; }
        .rule { margin-top:4px; }
        .rule.valid { color:#166534; font-weight:600; }
    </style>
</head>
<body>
    <div class="card">
        <h2 class="title">Bước 4: Tạo mật khẩu</h2>
        <p class="sub">Tài khoản: <strong><%= fullName %></strong> - <%= contactType %>: <strong><%= contactValue %></strong></p>
        <% if (error) { %><div class="alert"><%= error %></div><% } %>
        <form action="/create-password" method="POST" id="createPasswordForm">
            <label>Mật khẩu</label>
            <input type="password" id="password" name="password" required>
            <label>Xác nhận mật khẩu</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required>

            <div class="password-rules" id="passwordRules">
                <strong>Yêu cầu mật khẩu</strong>
                <div class="rule" id="req-length">Ít nhất 8 ký tự</div>
                <div class="rule" id="req-upper">Ít nhất 1 chữ hoa</div>
                <div class="rule" id="req-lower">Ít nhất 1 chữ thường</div>
                <div class="rule" id="req-number">Ít nhất 1 chữ số</div>
                <div class="rule" id="req-special">Ít nhất 1 ký tự đặc biệt (@$!%*?&)</div>
            </div>

            <div class="row" style="margin-top:12px;">
                <button class="btn" type="submit" id="submitBtn" disabled>Hoàn tất đăng ký</button>
                <a href="/verify-otp?type=registration" class="btn secondary">Quay lại</a>
            </div>
        </form>
    </div>

    <script>
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const passwordRules = document.getElementById('passwordRules');
        const submitBtn = document.getElementById('submitBtn');
        const requirements = {
            length: document.getElementById('req-length'),
            upper: document.getElementById('req-upper'),
            lower: document.getElementById('req-lower'),
            number: document.getElementById('req-number'),
            special: document.getElementById('req-special')
        };

        function validatePassword() {
            const password = passwordInput.value;
            const confirmPassword = confirmPasswordInput.value;
            const checks = {
                length: password.length >= 8,
                upper: /[A-Z]/.test(password),
                lower: /[a-z]/.test(password),
                number: /\d/.test(password),
                special: /[@$!%*?&]/.test(password)
            };
            Object.keys(checks).forEach((key) => {
                requirements[key].classList.toggle('valid', checks[key]);
            });
            const allValid = Object.values(checks).every(Boolean);
            const matched = password && confirmPassword && password === confirmPassword;
            submitBtn.disabled = !(allValid && matched);
        }

        passwordInput.addEventListener('focus', () => passwordRules.style.display = 'block');
        passwordInput.addEventListener('input', validatePassword);
        confirmPasswordInput.addEventListener('input', validatePassword);
    </script>
</body>
</html>
