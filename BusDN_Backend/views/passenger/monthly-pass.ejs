<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mua vé tháng - BusDN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        body { background: #f4f6f9; font-family: 'Inter', 'Segoe UI', sans-serif; }
        button, input, select, textarea { font-family: 'Inter', 'Segoe UI', sans-serif; }
        h1, h2, h3, h4, h5, h6, .display-6, .fw-bold { font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; }
        .page-card { border: 0; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,.04); }
        .feature-card {
            background: linear-gradient(135deg, #0d4f9b 0%, #003f88 100%);
            color: #fff;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 12px 30px rgba(0, 64, 136, .25);
        }
        .money-out { color: #dc3545; font-weight: 700; }
        .pass-code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            font-size: .9rem;
        }
        .route-info-box {
            background: #f8fbff;
            border: 1px solid #dce8ff;
            border-radius: 12px;
            padding: 12px 14px;
        }
    </style>
</head>
<body>
    <%
      const _user = (typeof user !== 'undefined' && user) ? user : {};
      const _routes = (typeof routes !== 'undefined' && Array.isArray(routes)) ? routes : [];
      const _myPasses = (typeof myPasses !== 'undefined' && Array.isArray(myPasses)) ? myPasses : [];
      const _selectedRouteId = (typeof selectedRouteId !== 'undefined' && selectedRouteId) ? String(selectedRouteId) : "";
      const _selectedPassType = (typeof selectedPassType !== 'undefined' && selectedPassType) ? String(selectedPassType) : "SINGLE_ROUTE";
      const _selectedPaymentMethod = (typeof selectedPaymentMethod !== 'undefined' && selectedPaymentMethod) ? String(selectedPaymentMethod) : "VNPAY";
      const _selectedMonth = (typeof selectedMonth !== 'undefined' && selectedMonth) ? Number(selectedMonth) : (new Date().getMonth() + 1);
      const _selectedYear = (typeof selectedYear !== 'undefined' && selectedYear) ? Number(selectedYear) : (new Date().getFullYear());
      const _selectedPromoCode = (typeof selectedPromoCode !== 'undefined' && selectedPromoCode) ? String(selectedPromoCode) : "";
      const _interRouteMonthlyPrice = Number((typeof interRouteMonthlyPrice !== 'undefined' ? interRouteMonthlyPrice : 300000) || 300000);
      const _priorityDiscountPercent = Number((typeof priorityDiscountPercent !== 'undefined' ? priorityDiscountPercent : 0) || 0);
      const _priorityDiscountEligible = Boolean((typeof priorityDiscountEligible !== 'undefined') ? priorityDiscountEligible : false);
      const _freeRideRules = (typeof freeRideRules !== 'undefined' && freeRideRules) ? freeRideRules : null;
      const _error = (typeof error !== 'undefined') ? error : null;
      const _success = (typeof success !== 'undefined') ? success : null;
      const _now = new Date();
      const _currentMonth = _now.getMonth() + 1;
      const _currentYear = _now.getFullYear();
      const _safeSelectedYear = Number(_selectedYear) < _currentYear ? _currentYear : Number(_selectedYear);
      const _safeSelectedMonth = _safeSelectedYear === _currentYear && Number(_selectedMonth) < _currentMonth
        ? _currentMonth
        : Number(_selectedMonth);
    %>

    <%- include('../partials/header') %>

    <div class="container my-4 my-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="fw-bold mb-1">Mua vé tháng</h2>
                <div class="text-muted">Thanh toán trực tiếp qua VNPAY hoặc MoMo</div>
            </div>
            <a href="/profile" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i> Quay lại hồ sơ
            </a>
        </div>

        <% if (_error) { %>
            <div class="alert alert-danger"><%= _error %></div>
        <% } %>
        <% if (_success) { %>
            <div class="alert alert-success"><%= _success %></div>
        <% } %>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="feature-card mb-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="opacity-75">Thanh toán</div>
                            <div class="display-6 fw-bold mt-1">VNPAY / MoMo</div>
                            <div class="mt-2"><%= _user?.fullName || "Hành khách" %></div>
                        </div>
                        <i class="fa-solid fa-credit-card fa-2x opacity-75"></i>
                    </div>
                </div>
                <div class="card page-card mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Hướng dẫn</h5>
                        <% if (_priorityDiscountEligible && _priorityDiscountPercent > 0) { %>
                            <div class="alert alert-success py-2 small">
                                Tài khoản ưu tiên đang được giảm <strong><%= _priorityDiscountPercent %>%</strong>.
                            </div>
                        <% } %>
                        <ul class="mb-0">
                            <li>Chọn loại vé: đơn tuyến hoặc liên tuyến</li>
                            <li>Chọn tháng/năm áp dụng</li>
                            <li>Chọn cổng thanh toán: VNPAY hoặc MoMo</li>
                            <li>Bấm thanh toán để chuyển sang cổng đã chọn</li>
                            <li>Vé được kích hoạt sau khi giao dịch thành công</li>
                        </ul>
                        <% if (_freeRideRules && _freeRideRules.enabled) { %>
                            <hr>
                            <div class="small text-muted">
                                Quy tắc miễn phí vé lượt hiện hành: dưới <strong><%= _freeRideRules.underAge %></strong> tuổi
                                hoặc từ <strong><%= _freeRideRules.overAge %></strong> tuổi.
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="card page-card">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Vé tháng gần đây</h5>
                        <% if (_myPasses.length === 0) { %>
                            <div class="text-muted">Bạn chưa có vé tháng nào.</div>
                        <% } else { %>
                            <div class="list-group list-group-flush">
                                <% _myPasses.slice(0,5).forEach(pass => { %>
                                    <div class="list-group-item px-0">
                                        <div class="fw-semibold">
                                            <%= pass.displayRouteNumber ? `${pass.displayRouteNumber} - ${pass.displayRouteName}` : pass.displayRouteName %>
                                        </div>
                                        <div class="small text-muted">
                                            Mã thẻ: <span class="pass-code"><%= pass.passCode %></span>
                                        </div>
                                        <div class="small text-muted">
                                            Tháng <%= String(pass.month).padStart(2,'0') %>/<%= pass.year %> ·
                                            <%= Number(pass.pricePaid || 0).toLocaleString("vi-VN") %> đ
                                        </div>
                                        <div class="mt-1">
                                            <span class="badge <%= pass.status === 'ACTIVE' ? 'text-bg-success' : (pass.status === 'EXPIRED' ? 'text-bg-secondary' : 'text-bg-danger') %>">
                                                <%= pass.status %>
                                            </span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card page-card mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Đăng ký mua vé tháng</h5>

                        <% if (_routes.length === 0) { %>
                            <div class="alert alert-warning">
                                Hiện chưa có tuyến hoạt động cho vé đơn tuyến. Bạn vẫn có thể mua vé liên tuyến.
                            </div>
                        <% } %>

                        <form method="POST" action="/passenger/passes/monthly/purchase" id="monthlyPassForm">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">1) Loại vé</label>
                                <div class="d-flex flex-column flex-md-row gap-2">
                                    <div class="form-check border rounded-3 p-3 flex-fill">
                                        <input class="form-check-input" type="radio" name="passType" id="passTypeSingle" value="SINGLE_ROUTE" <%= _selectedPassType !== 'INTER_ROUTE' ? 'checked' : '' %>>
                                        <label class="form-check-label fw-semibold" for="passTypeSingle">Vé đơn tuyến</label>
                                    </div>
                                    <div class="form-check border rounded-3 p-3 flex-fill">
                                        <input class="form-check-input" type="radio" name="passType" id="passTypeInter" value="INTER_ROUTE" <%= _selectedPassType === 'INTER_ROUTE' ? 'checked' : '' %>>
                                        <label class="form-check-label fw-semibold" for="passTypeInter">Vé liên tuyến</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3" id="routeSelectWrap">
                                <label class="form-label fw-semibold">2) Chọn tuyến (cho vé đơn tuyến)</label>
                                <select class="form-select" name="routeId" id="routeSelect">
                                    <option value="">-- Chọn tuyến xe --</option>
                                    <% _routes.forEach(r => { %>
                                        <option
                                            value="<%= r._id %>"
                                            data-route-number="<%= r.routeNumber %>"
                                            data-route-name="<%= r.name %>"
                                            data-price="<%= Number(r.effectiveMonthlyPassPrice || 0) %>"
                                            data-description="<%= r.description || 'Tuyến xe BusDN' %>"
                                            data-start="<%= r.operationTime?.start || '' %>"
                                            data-end="<%= r.operationTime?.end || '' %>"
                                            <%= _selectedRouteId === String(r._id) ? 'selected' : '' %>>
                                            <%= r.routeNumber %> - <%= r.name %> · <%= Number(r.effectiveMonthlyPassPrice || 0).toLocaleString("vi-VN") %> đ
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="route-info-box mb-3" id="routeInfoBox">
                                <div class="fw-semibold mb-1" id="routeInfoTitle">Chưa chọn tuyến</div>
                                <div class="small text-muted" id="routeInfoDesc">Vui lòng chọn tuyến trong danh sách.</div>
                                <div class="small text-muted mt-1" id="routeInfoTime"></div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">3) Tháng</label>
                                    <select class="form-select" name="month" id="monthInput" required>
                                        <% for (let m = 1; m <= 12; m++) { %>
                                            <option value="<%= m %>" <%= Number(_safeSelectedMonth) === m ? 'selected' : '' %>>
                                                Tháng <%= String(m).padStart(2, '0') %>
                                            </option>
                                        <% } %>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">4) Năm</label>
                                    <select class="form-select" name="year" id="yearInput" required>
                                        <%
                                            for (let y = _currentYear; y <= _currentYear + 2; y++) {
                                        %>
                                            <option value="<%= y %>" <%= Number(_safeSelectedYear) === y ? 'selected' : '' %>>
                                                <%= y %>
                                            </option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">5) Cổng thanh toán</label>
                                <div class="d-flex flex-column flex-md-row gap-2">
                                    <div class="form-check border rounded-3 p-3 flex-fill">
                                        <input class="form-check-input" type="radio" name="paymentMethod" id="paymentMethodVnpay" value="VNPAY" <%= _selectedPaymentMethod !== 'MOMO' ? 'checked' : '' %>>
                                        <label class="form-check-label fw-semibold" for="paymentMethodVnpay">VNPAY</label>
                                    </div>
                                    <div class="form-check border rounded-3 p-3 flex-fill">
                                        <input class="form-check-input" type="radio" name="paymentMethod" id="paymentMethodMomo" value="MOMO" <%= _selectedPaymentMethod === 'MOMO' ? 'checked' : '' %>>
                                        <label class="form-check-label fw-semibold" for="paymentMethodMomo">MoMo</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">6) Mã giảm giá (nếu có)</label>
                                <div class="input-group">
                                    <input
                                        type="text"
                                        class="form-control text-uppercase"
                                        name="promoCode"
                                        id="promoCodeInput"
                                        maxlength="30"
                                        placeholder="Nhập mã khuyến mãi"
                                        value="<%= _selectedPromoCode %>">
                                    <button class="btn btn-outline-primary" type="button" id="applyPromoBtn">
                                        Áp mã
                                    </button>
                                </div>
                                <div class="form-text">Bấm "Áp mã" để kiểm tra và hiển thị giảm giá ngay.</div>
                                <div id="promoApplyStatus" class="small mt-2 text-muted"></div>
                            </div>

                            <div class="border rounded-3 p-3 mb-3 bg-light">
                                <div class="fw-semibold mb-2">Thông tin thanh toán</div>
                                <div class="small text-muted mb-2">Bạn sẽ thanh toán qua cổng đã chọn</div>
                                <div class="d-flex justify-content-between">
                                    <span>Cổng thanh toán</span>
                                    <span class="fw-semibold" id="selectedPaymentMethodText"><%= _selectedPaymentMethod === 'MOMO' ? 'MoMo' : 'VNPAY' %></span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Tuyến đã chọn</span>
                                    <span class="fw-semibold" id="selectedRouteText">Chưa chọn tuyến</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Kỳ vé tháng</span>
                                    <span class="fw-semibold" id="selectedPeriodText">
                                        <%= String(_selectedMonth).padStart(2,'0') %>/<%= _selectedYear %>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between mt-2">
                                    <span>Giá gốc</span>
                                    <span class="fw-semibold" id="basePriceText">0 đ</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Đối tượng ưu tiên</span>
                                    <span class="fw-semibold text-success" id="discountText">0 đ</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Mã giảm giá</span>
                                    <span class="fw-semibold text-success" id="promoCodeText">Chưa áp dụng</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Giảm từ mã</span>
                                    <span class="fw-semibold text-success" id="promoDiscountText">0 đ</span>
                                </div>
                                <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                                    <span class="fw-semibold">Thanh toán</span>
                                    <span class="fw-bold text-primary" id="finalPriceText">0 đ</span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold" id="payBtn">
                                <i class="fa-solid fa-credit-card me-2"></i> Thanh toán
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card page-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Danh sách vé tháng của tôi</h5>
                            <span class="badge rounded-pill text-bg-light">Tối đa 20 vé gần nhất</span>
                        </div>

                        <% if (_myPasses.length === 0) { %>
                            <div class="text-center py-5 text-muted">
                                <i class="fa-solid fa-ticket fa-2x mb-3 opacity-50"></i>
                                <div>Chưa có vé tháng nào.</div>
                            </div>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Mã thẻ</th>
                                            <th>Tuyến</th>
                                            <th>Kỳ vé</th>
                                            <th>Giá</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% _myPasses.forEach(pass => { %>
                                            <tr>
                                                <td class="pass-code"><%= pass.passCode %></td>
                                                <td>
                                                    <div class="fw-semibold">
                                                        <%= pass.displayRouteNumber ? `${pass.displayRouteNumber} - ${pass.displayRouteName}` : pass.displayRouteName %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">
                                                        <%= String(pass.month).padStart(2, '0') %>/<%= pass.year %>
                                                    </div>
                                                    <small class="text-muted">
                                                        <%= pass.validFrom ? new Date(pass.validFrom).toLocaleDateString("vi-VN") : "-" %> -
                                                        <%= pass.validTo ? new Date(pass.validTo).toLocaleDateString("vi-VN") : "-" %>
                                                    </small>
                                                </td>
                                                <td class="money-out">
                                                    - <%= Number(pass.pricePaid || 0).toLocaleString("vi-VN") %> đ
                                                </td>
                                                <td>
                                                    <span class="badge <%= pass.status === 'ACTIVE' ? 'text-bg-success' : (pass.status === 'EXPIRED' ? 'text-bg-secondary' : 'text-bg-danger') %>">
                                                        <%= pass.status %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const interRouteMonthlyPrice = Number(<%- JSON.stringify(_interRouteMonthlyPrice) %>);
            const priorityDiscountPercent = Number(<%- JSON.stringify(_priorityDiscountPercent) %>);
            const priorityDiscountEligible = Boolean(<%- JSON.stringify(_priorityDiscountEligible) %>);
            const routeSelect = document.getElementById("routeSelect");
            const routeSelectWrap = document.getElementById("routeSelectWrap");
            const passTypeSingle = document.getElementById("passTypeSingle");
            const passTypeInter = document.getElementById("passTypeInter");
            const paymentMethodVnpay = document.getElementById("paymentMethodVnpay");
            const paymentMethodMomo = document.getElementById("paymentMethodMomo");
            const monthInput = document.getElementById("monthInput");
            const yearInput = document.getElementById("yearInput");
            const selectedPaymentMethodText = document.getElementById("selectedPaymentMethodText");
            const selectedRouteText = document.getElementById("selectedRouteText");
            const selectedPeriodText = document.getElementById("selectedPeriodText");
            const basePriceText = document.getElementById("basePriceText");
            const discountText = document.getElementById("discountText");
            const promoCodeInput = document.getElementById("promoCodeInput");
            const applyPromoBtn = document.getElementById("applyPromoBtn");
            const promoApplyStatus = document.getElementById("promoApplyStatus");
            const promoCodeText = document.getElementById("promoCodeText");
            const promoDiscountText = document.getElementById("promoDiscountText");
            const finalPriceText = document.getElementById("finalPriceText");
            const payBtn = document.getElementById("payBtn");
            const form = document.getElementById("monthlyPassForm");
            const routeInfoTitle = document.getElementById("routeInfoTitle");
            const routeInfoDesc = document.getElementById("routeInfoDesc");
            const routeInfoTime = document.getElementById("routeInfoTime");
            const today = new Date();
            const currentMonth = today.getMonth() + 1;
            const currentYear = today.getFullYear();
            let appliedPromo = null;

            if (!form) return;

            function fmt(v) {
                return Number(v || 0).toLocaleString("vi-VN") + " đ";
            }

            function getPassType() {
                return passTypeInter && passTypeInter.checked ? "INTER_ROUTE" : "SINGLE_ROUTE";
            }

            function getPaymentMethod() {
                return paymentMethodMomo && paymentMethodMomo.checked ? "MOMO" : "VNPAY";
            }

            function getDiscountPercent() {
                if (!priorityDiscountEligible) return 0;
                return Math.max(0, Math.min(100, Number(priorityDiscountPercent || 0)));
            }

            function getSelectedOption() {
                if (!routeSelect) return null;
                const opt = routeSelect.options[routeSelect.selectedIndex];
                if (!opt || !opt.value) return null;
                return opt;
            }

            function calcPrice(basePrice) {
                const safeBase = Number(basePrice || 0);
                const discountAmount = Math.round((safeBase * getDiscountPercent()) / 100);
                const payable = Math.max(0, safeBase - discountAmount);
                return { safeBase, discountAmount, payable };
            }

            function setPromoStatus(message, type) {
                if (!promoApplyStatus) return;
                promoApplyStatus.className = "small mt-2";
                if (type === "success") promoApplyStatus.classList.add("text-success");
                else if (type === "error") promoApplyStatus.classList.add("text-danger");
                else promoApplyStatus.classList.add("text-muted");
                promoApplyStatus.textContent = message || "";
            }

            function resetAppliedPromo(showMessage) {
                if (!appliedPromo) return;
                appliedPromo = null;
                if (showMessage) {
                    setPromoStatus("Đã thay đổi lựa chọn, vui lòng áp mã lại.", "muted");
                }
            }

            function normalizePeriodSelection() {
                if (!monthInput || !yearInput) return false;

                const selectedYear = Number(yearInput.value || 0);
                const selectedMonth = Number(monthInput.value || 0);
                let changed = false;

                Array.from(yearInput.options).forEach(function (option) {
                    option.disabled = Number(option.value) < currentYear;
                });

                Array.from(monthInput.options).forEach(function (option) {
                    const monthValue = Number(option.value);
                    option.disabled = selectedYear === currentYear && monthValue < currentMonth;
                });

                if (selectedYear < currentYear) {
                    yearInput.value = String(currentYear);
                    changed = true;
                }

                const normalizedYear = Number(yearInput.value || currentYear);
                if (normalizedYear === currentYear && selectedMonth < currentMonth) {
                    monthInput.value = String(currentMonth);
                    changed = true;
                }

                return changed;
            }

            function getCurrentContextKey() {
                const selected = getSelectedOption();
                return [
                    getPassType(),
                    selected ? String(selected.value) : "",
                    monthInput ? String(monthInput.value || "") : "",
                    yearInput ? String(yearInput.value || "") : ""
                ].join("|");
            }

            function renderPrice(basePrice) {
                const { safeBase, discountAmount, payable } = calcPrice(basePrice);
                const promoDiscountAmount = Number(appliedPromo?.discountAmount || 0);
                const finalPayable = Math.max(0, payable - promoDiscountAmount);
                if (basePriceText) basePriceText.textContent = fmt(safeBase);
                if (discountText) discountText.textContent = `- ${fmt(discountAmount)}`;
                if (promoDiscountText) promoDiscountText.textContent = `- ${fmt(promoDiscountAmount)}`;
                if (finalPriceText) finalPriceText.textContent = fmt(finalPayable);
                if (promoCodeText) {
                    const code = String(promoCodeInput?.value || "").trim().toUpperCase();
                    promoCodeText.textContent = appliedPromo
                        ? `${appliedPromo.code} (đã áp dụng)`
                        : (code ? `${code} (chưa áp dụng)` : "Chưa áp dụng");
                }
            }

            function updateSummary() {
                const passType = getPassType();
                const selected = getSelectedOption();
                const month = monthInput ? monthInput.value : "";
                const year = yearInput ? yearInput.value : "";
                const paymentMethod = getPaymentMethod();

                if (selectedPeriodText) {
                    selectedPeriodText.textContent = `${String(month).padStart(2, "0")}/${year}`;
                }
                if (selectedPaymentMethodText) {
                    selectedPaymentMethodText.textContent = paymentMethod === "MOMO" ? "MoMo" : "VNPAY";
                }
                if (payBtn) {
                    payBtn.innerHTML = paymentMethod === "MOMO"
                        ? '<i class="fa-solid fa-credit-card me-2"></i> Thanh toán với MoMo'
                        : '<i class="fa-solid fa-credit-card me-2"></i> Thanh toán với VNPAY';
                }

                if (routeSelectWrap) routeSelectWrap.style.display = passType === "INTER_ROUTE" ? "none" : "";
                if (routeSelect) routeSelect.required = passType === "SINGLE_ROUTE";

                if (passType === "INTER_ROUTE") {
                    if (selectedRouteText) selectedRouteText.textContent = "Vé liên tuyến (toàn mạng)";
                    renderPrice(interRouteMonthlyPrice);
                    if (routeInfoTitle) routeInfoTitle.textContent = "Vé liên tuyến";
                    if (routeInfoDesc) routeInfoDesc.textContent = "Áp dụng toàn bộ tuyến xe buýt BusDN trong tháng đã chọn.";
                    if (routeInfoTime) routeInfoTime.textContent = "";
                    return;
                }

                if (!selected) {
                    if (selectedRouteText) selectedRouteText.textContent = "Chưa chọn tuyến";
                    renderPrice(0);
                    if (routeInfoTitle) routeInfoTitle.textContent = "Chưa chọn tuyến";
                    if (routeInfoDesc) routeInfoDesc.textContent = "Vui lòng chọn tuyến trong danh sách.";
                    if (routeInfoTime) routeInfoTime.textContent = "";
                    return;
                }

                const routeNumber = selected.dataset.routeNumber || "";
                const routeName = selected.dataset.routeName || "";
                const description = selected.dataset.description || "Tuyến xe BusDN";
                const start = selected.dataset.start || "";
                const end = selected.dataset.end || "";
                const originalPrice = Number(selected.dataset.price || 0);

                if (selectedRouteText) selectedRouteText.textContent = `${routeNumber} - ${routeName}`;
                renderPrice(originalPrice);
                if (routeInfoTitle) routeInfoTitle.textContent = `${routeNumber} - ${routeName}`;
                if (routeInfoDesc) routeInfoDesc.textContent = description;
                if (routeInfoTime) routeInfoTime.textContent = (start && end) ? `Giờ hoạt động: ${start} - ${end}` : "";
            }

            if (passTypeSingle) passTypeSingle.addEventListener("change", function () { resetAppliedPromo(true); updateSummary(); });
            if (passTypeInter) passTypeInter.addEventListener("change", function () { resetAppliedPromo(true); updateSummary(); });
            if (paymentMethodVnpay) paymentMethodVnpay.addEventListener("change", updateSummary);
            if (paymentMethodMomo) paymentMethodMomo.addEventListener("change", updateSummary);
            if (monthInput) monthInput.addEventListener("change", function () {
                const changed = normalizePeriodSelection();
                resetAppliedPromo(true);
                if (changed) setPromoStatus("Không thể chọn tháng trong quá khứ.", "error");
                updateSummary();
            });
            if (yearInput) yearInput.addEventListener("change", function () {
                const changed = normalizePeriodSelection();
                resetAppliedPromo(true);
                if (changed) setPromoStatus("Không thể chọn tháng trong quá khứ.", "error");
                updateSummary();
            });
            if (promoCodeInput) promoCodeInput.addEventListener("input", function () {
                const code = String(promoCodeInput.value || "").trim().toUpperCase();
                promoCodeInput.value = code;
                if (!appliedPromo || code !== appliedPromo.code) {
                    appliedPromo = null;
                }
                updateSummary();
            });

            if (routeSelect) routeSelect.addEventListener("change", function () { resetAppliedPromo(true); updateSummary(); });

            async function applyPromo() {
                if (!promoCodeInput) return;
                const promoCode = String(promoCodeInput.value || "").trim().toUpperCase();
                promoCodeInput.value = promoCode;

                if (!promoCode) {
                    appliedPromo = null;
                    setPromoStatus("Vui lòng nhập mã giảm giá.", "error");
                    updateSummary();
                    return;
                }

                const passType = getPassType();
                const selected = getSelectedOption();
                if (passType === "SINGLE_ROUTE" && (!selected || !selected.value)) {
                    setPromoStatus("Vui lòng chọn tuyến trước khi áp mã.", "error");
                    return;
                }

                const contextKey = getCurrentContextKey();
                if (applyPromoBtn) {
                    applyPromoBtn.disabled = true;
                    applyPromoBtn.textContent = "Đang kiểm tra...";
                }

                try {
                    const params = new URLSearchParams({
                        promoCode,
                        passType,
                        routeId: selected?.value || ""
                    });
                    const res = await fetch(`/passenger/passes/monthly/promo-preview?${params.toString()}`, {
                        method: "GET",
                        headers: { Accept: "application/json" }
                    });
                    const data = await res.json();
                    if (!res.ok || !data.ok || !data.applied) {
                        appliedPromo = null;
                        setPromoStatus(data?.message || "Mã giảm giá không hợp lệ.", "error");
                        updateSummary();
                        return;
                    }

                    appliedPromo = {
                        code: String(data.promoCode || promoCode),
                        discountAmount: Number(data.promoDiscountAmount || 0),
                        contextKey
                    };
                    setPromoStatus(data.message || "Áp mã thành công.", "success");
                    updateSummary();
                } catch (err) {
                    appliedPromo = null;
                    setPromoStatus("Không thể kiểm tra mã giảm giá. Vui lòng thử lại.", "error");
                    updateSummary();
                } finally {
                    if (applyPromoBtn) {
                        applyPromoBtn.disabled = false;
                        applyPromoBtn.textContent = "Áp mã";
                    }
                }
            }

            if (applyPromoBtn) applyPromoBtn.addEventListener("click", applyPromo);

            form.addEventListener("submit", function (e) {
                const passType = getPassType();
                const selected = getSelectedOption();
                const periodChanged = normalizePeriodSelection();
                if (promoCodeInput) {
                    promoCodeInput.value = String(promoCodeInput.value || "").trim().toUpperCase();
                }
                if (periodChanged) {
                    setPromoStatus("Không thể chọn tháng trong quá khứ.", "error");
                    updateSummary();
                    e.preventDefault();
                    return;
                }
                if (appliedPromo && appliedPromo.contextKey !== getCurrentContextKey()) {
                    appliedPromo = null;
                    setPromoStatus("Đã thay đổi thông tin đơn, vui lòng áp mã lại.", "error");
                    updateSummary();
                    e.preventDefault();
                    return;
                }
                if (passType === "SINGLE_ROUTE" && (!selected || !selected.value)) {
                    e.preventDefault();
                    alert("Vui lòng chọn tuyến xe.");
                    return;
                }
            });
            normalizePeriodSelection();
            updateSummary();
        })();
    </script>
</body>
</html>
